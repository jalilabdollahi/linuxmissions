def usage_text():
    return USAGES.get(PROG, "Usage: %s (mock; see mocks/README.md)" % PROG).rstrip("\n")


def usage(code=2):
    raise Exit(code, usage_text())


def help_exit():
    sys.stdout.write(USAGES.get(PROG, "") + "\n")
    raise Exit(0)


def numeric_arg(v, lo=None):
    if not re.match(r"^-?\d+$", v):
        die(3, "%s: invalid numeric argument '%s'" % (PROG, v))
    n = int(v)
    if lo is not None and n < lo:
        die(3, "%s: invalid numeric argument '%s'" % (PROG, v))
    return n


def age_field(n):
    return "" if n is None or n < 0 else str(n)


def update_member_lists(db, user, wanted, append, remove):
    """Supplementary groups: wanted is a list of group names, or None."""
    wanted_set = set(wanted or [])
    for t in (db.group, db.gshadow):
        if not t.exists:
            continue
        for i, f in list(t.rows()):
            row = t.fields(i)
            mem = members(row[3])
            is_member = user in mem
            want = row[0] in wanted_set
            if remove:
                if want and is_member:
                    mem = [m for m in mem if m != user]
            elif append:
                if want and not is_member:
                    mem.append(user)
            else:
                if want and not is_member:
                    mem.append(user)
                elif not want and is_member:
                    mem = [m for m in mem if m != user]
            row[3] = set_members(mem)
            t.set(i, row)


def check_groups(db, spec):
    out = []
    for g in [x for x in spec.split(",") if x]:
        e = db.group_entry(g)
        if e is None:
            die(6, "%s: group '%s' does not exist" % (PROG, g))
        if e[0] not in out:
            out.append(e[0])
    return out


