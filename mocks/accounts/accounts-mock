def login_defs():
    """login.defs values; Ubuntu 24.04's defaults when the fake root has no file."""
    txt = read_text(rp("etc/login.defs"))
    if txt is None:
        return dict(LOGIN_DEFS)
    vals = {}
    for line in txt.splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        parts = s.split(None, 1)
        vals[parts[0]] = parts[1].strip().strip('"') if len(parts) > 1 else ""
    out = {}
    for k, v in LOGIN_DEFS.items():
        if k in ("HOME_MODE", "PASS_MAX_DAYS", "PASS_MIN_DAYS", "PASS_WARN_AGE") and k not in vals:
            continue
        out[k] = v
    out.update(vals)
    return out


def defnum(defs, key, default):
    v = defs.get(key)
    if v is None:
        return default
    try:
        return int(v, 0) if v.startswith("0") and len(v) > 1 else int(v)
    except ValueError:
        return default


def defbool(defs, key, default=False):
    v = defs.get(key)
    if v is None:
        return default
    return v.lower() == "yes"


USERADD_DEFAULTS = {"GROUP": "100", "HOME": "/home", "INACTIVE": "-1", "EXPIRE": "", "SHELL": "/bin/sh",
                    "SKEL": "/etc/skel", "CREATE_MAIL_SPOOL": "no", "LOG_INIT": "yes"}


def useradd_defaults():
    d = dict(USERADD_DEFAULTS)
    txt = read_text(rp("etc/default/useradd"), "") or ""
    for line in txt.splitlines():
        s = line.strip()
        if not s or s.startswith("#") or "=" not in s:
            continue
        k, v = s.split("=", 1)
        d[k.strip()] = v.strip().strip('"')
    return d


# --------------------------------------------------------------- helpers

NAME_RX = re.compile(r"^[a-z_][a-z0-9_-]*[$]?$")


def valid_name(name, badname=False):
    if not name or len(name) > 32 or name in (".", "..") or name.isdigit():
        return False
    if badname:
        return not any(c in name for c in ":,\n \t/") and not name.startswith("-")
    return bool(NAME_RX.match(name))


def valid_field(v):
    return ":" not in v and "\n" not in v


def members(s):
    return [m for m in s.split(",") if m]


def set_members(lst):
    return ",".join(lst)


def find_new_id(used, lo, hi, system, preferred=None):
    """shadow-utils 4.13 find_new_uid()/find_new_gid()."""
    if preferred is not None and lo <= preferred <= hi and preferred not in used:
        return preferred
    in_range = [u for u in used if lo <= u <= hi]
    if system:
        cand = (min(in_range) - 1) if in_range else hi
        if cand >= lo and cand not in used:
            return cand
        for c in range(hi, lo - 1, -1):
            if c not in used:
                return c
    else:
        cand = (max(in_range) + 1) if in_range else lo
        if cand <= hi and cand not in used:
            return cand
        for c in range(lo, hi + 1):
            if c not in used:
                return c
    return None


def find_free_range(table, lo, hi, count):
    """shadow's find_free_range(): lowest start >= lo that overlaps no existing range."""
    ranges = []
    for _i, f in table.rows():
        try:
            ranges.append((int(f[1]), int(f[2])))
        except (IndexError, ValueError):
            continue
    ranges.sort()
    cand = lo
    for start, cnt in ranges:
        end = start + cnt
        if cand + count <= start:
            break
        if end > cand:
            cand = end
    if cand + count - 1 > hi:
        return None
    return cand


def shell_warning(shell):
    if not shell or shell.startswith("*"):
        return
    # Only judge when the fake root holds a captured system tree (it has a shell binary).
    has_bins = any(os.path.exists(rp(d)) for d in ("bin/sh", "usr/bin/sh", "bin/bash", "usr/bin/bash"))
    if not has_bins or shell in ("/sbin/nologin", "/usr/sbin/nologin"):
        return
    real = rp(shell)
    if not os.path.exists(real) or os.path.isdir(real) or not os.access(real, os.X_OK):
        err("%s: Warning: missing or non-executable shell '%s'" % (PROG, shell))


def copy_skel(src, dst):
    for entry in sorted(os.listdir(src)):
        s = os.path.join(src, entry)
        d = os.path.join(dst, entry)
        if os.path.islink(s):
            os.symlink(os.readlink(s), d)
        elif os.path.isdir(s):
            os.mkdir(d)
            copy_skel(s, d)
            os.chmod(d, stat.S_IMODE(os.lstat(s).st_mode))
        else:
            shutil.copy2(s, d)


def inside_root(path):
    real = os.path.realpath(rp(path))
    root = os.path.realpath(ROOT)
    return real != root and real.startswith(root + os.sep)


def parse_opts(argv, short, long_opts, unsupported_opts=()):
    try:
        opts, args = getopt.gnu_getopt(argv, short, long_opts)
    except getopt.GetoptError as e:
        opt = e.opt or ""
        if "requires argument" in e.msg:
            if len(opt) == 1:
                err("%s: option requires an argument -- '%s'" % (PROG, opt))
            else:
                err("%s: option '--%s' requires an argument" % (PROG, opt))
        elif len(opt) == 1:
            err("%s: invalid option -- '%s'" % (PROG, opt))
        else:
            err("%s: unrecognized option '--%s'" % (PROG, opt))
        raise Exit(2, usage_text())
    for o, _v in opts:
        if o in unsupported_opts:
            unsupported(o)
    return opts, args


