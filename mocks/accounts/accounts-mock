#!/usr/bin/env python3
"""LinuxMissions mock account tools (python3 stdlib only, Python >= 3.8).

One multi-call program; the name it runs under picks the tool:

    useradd usermod userdel groupadd groupmod groupdel gpasswd passwd chage
    id groups getent

(`accounts-mock TOOL ARGS...` works too.) They edit the account databases of a
fake root instead of the real system: $ROOT/etc/passwd, group, shadow, gshadow,
login.defs, default/useradd, subuid, subgid, skel/ and the homes under $ROOT.
$ROOT is $LM_ROOT, or else the directory that holds the tool (a trailing bin/,
sbin/, usr/ or local/ is skipped when that directory has no etc/). shadow and
gshadow, subuid and subgid are only written when the file already exists, the
way shadow-utils behaves on a system without them.

Behaviour, messages and exit codes follow shadow-utils 4.13 (passwd package)
and coreutils/glibc on Ubuntu 24.04. Lines the tools do not touch stay
byte-identical. "Today" (shadow's last-change day) comes from $LM_NOW or
$ROOT/.lm/now when set. See mocks/README.md.
"""
import getopt
import os
import pwd
import re
import shutil
import stat
import sys
import time
from datetime import datetime, timedelta, timezone

ROOT = ""
PROG = ""


class Exit(Exception):
    def __init__(self, code, msg=None):
        Exception.__init__(self, msg or "")
        self.code = code
        self.msg = msg


def err(msg):
    sys.stderr.write(msg + "\n")


def die(code, msg):
    raise Exit(code, msg)


def unsupported(opt):
    die(2, "mock: option %s not supported" % opt)


# ------------------------------------------------------------------- paths

def find_root():
    env = os.environ.get("LM_ROOT")
    if env:
        return os.path.abspath(env)
    cur = os.path.dirname(os.path.abspath(sys.argv[0]))
    while os.path.basename(cur) in ("bin", "sbin", "usr", "local") and not os.path.isdir(os.path.join(cur, "etc")):
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent
    return cur


def rp(path):
    return os.path.join(ROOT, path.lstrip("/"))


def read_text(path, default=None):
    try:
        with open(path, encoding="utf-8", errors="surrogateescape") as fh:
            return fh.read()
    except OSError:
        return default


# ------------------------------------------------------------------- clock

def tz_from_name(name):
    if name in ("UTC", "Etc/UTC", "GMT", "Etc/GMT", "Z"):
        return timezone.utc
    m = re.match(r"^(?:UTC|GMT)?([+-])(\d{1,2}):?(\d{2})?$", name)
    if m:
        mins = int(m.group(2)) * 60 + int(m.group(3) or 0)
        return timezone(timedelta(minutes=-mins if m.group(1) == "-" else mins))
    try:
        from zoneinfo import ZoneInfo
        return ZoneInfo(name)
    except Exception:
        return None


def local_tz():
    name = os.environ.get("LM_TZ", "").strip()
    if not name:
        txt = read_text(rp("etc/timezone"), "") or ""
        name = txt.strip().split("\n")[0].strip()
    return tz_from_name(name or "UTC") or timezone.utc


def now():
    spec = os.environ.get("LM_NOW", "").strip() or (read_text(rp(".lm/now"), "") or "").strip()
    if spec:
        if spec.startswith("@"):
            try:
                return float(spec[1:])
            except ValueError:
                pass
        m = re.match(r"^(\d{4})-(\d{2})-(\d{2})(?:[ T](\d{1,2}):(\d{2})(?::(\d{2}))?)?\s*(Z|UTC|[+-]\d\d:?\d\d)?$",
                     spec)
        if m:
            tz = local_tz()
            if m.group(7):
                tz = tz_from_name("UTC" if m.group(7) in ("Z", "UTC") else m.group(7)) or tz
            dt = datetime(int(m.group(1)), int(m.group(2)), int(m.group(3)), int(m.group(4) or 0),
                          int(m.group(5) or 0), int(m.group(6) or 0), tzinfo=tz)
            return dt.timestamp()
    return time.time()


def today():
    return int(now() // 86400)


def day_to_date(day):
    return datetime(1970, 1, 1) + timedelta(days=day)


def strtoday(s):
    """shadow's strtoday(): '-1'/'' -> -1, 'N' -> N, 'YYYY-MM-DD' -> days since epoch, else None."""
    s = s.strip()
    if s in ("", "-1"):
        return -1
    if re.match(r"^-?\d+$", s):
        return int(s)
    m = re.match(r"^(\d{4})-(\d{1,2})-(\d{1,2})$", s)
    if m:
        try:
            return (datetime(int(m.group(1)), int(m.group(2)), int(m.group(3))) - datetime(1970, 1, 1)).days
        except ValueError:
            return None
    for fmt in ("%m/%d/%Y", "%m/%d/%y", "%b %d, %Y", "%d %b %Y", "%B %d, %Y"):
        try:
            return (datetime.strptime(s, fmt) - datetime(1970, 1, 1)).days
        except ValueError:
            continue
    return None


# --------------------------------------------------------------- databases

class Table(object):
    """A colon-separated database file. Untouched lines stay byte-identical."""

    def __init__(self, rel, nfields):
        self.rel = rel
        self.path = rp(rel)
        self.nfields = nfields
        txt = read_text(self.path)
        self.exists = txt is not None
        txt = txt or ""
        self.trailing = txt.endswith("\n") or txt == ""
        self.lines = txt.split("\n")
        if self.lines and self.lines[-1] == "":
            self.lines.pop()
        self.dirty = False

    def rows(self):
        for i, line in enumerate(self.lines):
            if not line or line.startswith("#") or line[0] in "+-":
                continue
            f = line.split(":")
            yield i, f

    def find(self, name):
        for i, f in self.rows():
            if f[0] == name:
                return i
        return None

    def get(self, name):
        i = self.find(name)
        return None if i is None else self.fields(i)

    def fields(self, i):
        f = self.lines[i].split(":")
        while len(f) < self.nfields:
            f.append("")
        return f

    def set(self, i, fields):
        new = ":".join(fields)
        if new != self.lines[i]:
            self.lines[i] = new
            self.dirty = True

    def append(self, fields):
        self.lines.append(":".join(fields))
        self.dirty = True

    def remove(self, i):
        del self.lines[i]
        self.dirty = True

    def names(self):
        return [f[0] for _i, f in self.rows()]

    def save(self):
        if not self.dirty:
            return
        text = "\n".join(self.lines) + ("\n" if self.lines else "")
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        with open(self.path, "w", encoding="utf-8", errors="surrogateescape") as fh:
            fh.write(text)
        self.dirty = False


class DB(object):
    def __init__(self):
        self.passwd = Table("etc/passwd", 7)
        self.group = Table("etc/group", 4)
        self.shadow = Table("etc/shadow", 9)
        self.gshadow = Table("etc/gshadow", 4)
        self.subuid = Table("etc/subuid", 3)
        self.subgid = Table("etc/subgid", 3)
        self.defs = login_defs()

    def save(self):
        for t in (self.passwd, self.shadow, self.group, self.gshadow, self.subuid, self.subgid):
            if t.exists or t is self.passwd or t is self.group:
                t.save()

    def user(self, name):
        return self.passwd.get(name)

    def user_by_uid(self, uid):
        for _i, f in self.passwd.rows():
            if len(f) > 2 and f[2] == str(uid):
                return f
        return None

    def group_entry(self, name_or_gid):
        g = self.group.get(name_or_gid)
        if g is not None:
            return g
        if re.match(r"^\d+$", name_or_gid):
            for i, f in self.group.rows():
                if len(f) > 2 and f[2] == name_or_gid:
                    return self.group.fields(i)
        return None

    def group_by_gid(self, gid):
        for i, f in self.group.rows():
            if len(f) > 2 and f[2] == str(gid):
                return self.group.fields(i)
        return None

    def used_uids(self):
        out = set()
        for _i, f in self.passwd.rows():
            if len(f) > 2 and f[2].isdigit():
                out.add(int(f[2]))
        return out

    def used_gids(self):
        out = set()
        for _i, f in self.group.rows():
            if len(f) > 2 and f[2].isdigit():
                out.add(int(f[2]))
        return out


