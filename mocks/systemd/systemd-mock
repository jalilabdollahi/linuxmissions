def builtin_text(name):
    desc, body = BUILTIN[name]
    return "[Unit]\nDescription=%s\nDocumentation=man:systemd.special(7)\n%s" % (desc, body)


def unit_type(name):
    return name.rsplit(".", 1)[1] if "." in name else ""


def mangle(name, default=".service"):
    if name.endswith(UNIT_SUFFIXES):
        return name
    if name.startswith("/"):
        return name
    return name + default


def split_instance(name):
    """'foo@eu.service' -> ('foo@.service', 'eu'); others -> (None, None)."""
    m = re.match(r"^([^@]+)@([^@]*)(\.[a-z]+)$", name)
    if not m:
        return None, None
    return m.group(1) + "@" + m.group(3), m.group(2)


def unit_dirs():
    seen = set()
    out = []
    for d in UNIT_DIRS:
        real = rp(d)
        if not os.path.isdir(real):
            continue
        key = os.path.realpath(real)
        if key in seen:
            continue
        seen.add(key)
        out.append((real, "/" + d))
    return out


def find_fragment(name):
    """-> (state, display_path, real_path). state: ok|masked|builtin|not-found."""
    tmpl, inst = split_instance(name)
    names = [name] + ([tmpl] if tmpl and inst else [])
    dirs = unit_dirs()
    for n in names:
        for real_dir, disp_dir in dirs:
            p = os.path.join(real_dir, n)
            if os.path.islink(p):
                if os.readlink(p) == "/dev/null":
                    return "masked", disp_dir + "/" + n, None
                real = root_resolve(disp_dir + "/" + n)
                if os.path.isfile(real):
                    return "ok", disp(real), real
                continue
            if os.path.isfile(p):
                return "ok", disp_dir + "/" + n, p
    if name in BUILTIN:
        return "builtin", "/usr/lib/systemd/system/" + name, None
    return "not-found", None, None


def find_dropins(name):
    tmpl, inst = split_instance(name)
    bases = [name] + ([tmpl] if tmpl and inst else []) + [unit_type(name)]
    chosen = {}
    for base in bases:
        for real_dir, disp_dir in unit_dirs():
            d = os.path.join(real_dir, base + ".d")
            try:
                entries = os.listdir(d)
            except OSError:
                continue
            for f in entries:
                if not f.endswith(".conf") or f in chosen:
                    continue
                p = os.path.join(d, f)
                if os.path.islink(p) and os.readlink(p) == "/dev/null":
                    chosen[f] = None
                    continue
                if os.path.isfile(p):
                    chosen[f] = ("%s/%s.d/%s" % (disp_dir, base, f), p)
    return [chosen[f] for f in sorted(chosen) if chosen[f]]


def disk_record(name):
    state, frag, real = find_fragment(name)
    rec = {"name": name, "state": state, "fragment": frag, "files": []}
    if state == "ok":
        rec["files"].append([frag, read_text(real, "")])
    elif state == "builtin":
        rec["files"].append([frag, builtin_text(name)])
    if state in ("ok", "builtin"):
        for dpath, real in find_dropins(name):
            rec["files"].append([dpath, read_text(real, "")])
    return rec


def parse_ini(text):
    """-> list of (section, key, value, lineno). Lines ending in '\\' continue."""
    out = []
    section = None
    lines = text.split("\n")
    i = 0
    while i < len(lines):
        lineno = i + 1
        line = lines[i]
        i += 1
        while line.rstrip().endswith("\\") and i < len(lines):
            nxt = lines[i]
            i += 1
            if nxt.lstrip().startswith(("#", ";")):
                continue
            line = line.rstrip()[:-1] + " " + nxt.strip()
        s = line.strip()
        if not s or s[0] in "#;":
            continue
        if s.startswith("[") and s.endswith("]"):
            section = s[1:-1]
            out.append((section, None, None, lineno))
            continue
        if "=" not in s:
            out.append((section, s, None, lineno))
            continue
        k, v = s.split("=", 1)
        out.append((section, k.strip(), v.strip(), lineno))
    return out


