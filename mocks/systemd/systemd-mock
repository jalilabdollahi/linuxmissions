def hostname():
    h = os.environ.get("LM_HOSTNAME", "").strip()
    if not h:
        txt = read_text(rp("etc/hostname"), "") or ""
        h = txt.strip().split("\n")[0].strip()
    return h or "localhost"


# -------------------------------------------------------------------- journal

RUNTIME_JOURNAL = "run/log/journal/runtime.json"
_BOOT_ID = []


def journal_files():
    env = os.environ.get("LM_JOURNAL")
    if env:
        return [p for p in env.split(":") if p]
    files = []
    for d in ("var/log/journal", "run/log/journal"):
        base = rp(d)
        found = sorted(glob.glob(os.path.join(base, "*.json")) + glob.glob(os.path.join(base, "*", "*.json")))
        runtime = rp(RUNTIME_JOURNAL)
        files += [f for f in found if f != runtime]
    if os.path.exists(rp(RUNTIME_JOURNAL)):
        files.append(rp(RUNTIME_JOURNAL))
    return files


def _norm_value(v):
    if isinstance(v, list) and all(isinstance(x, int) for x in v):
        return bytes(v).decode("utf-8", "replace")
    if isinstance(v, bool):
        return "1" if v else "0"
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, str):
        return v
    return json.dumps(v)


def load_entries(files=None):
    if files is None:
        files = journal_files()
    rows = []
    seq = 0
    ref = now()
    for f in files:
        try:
            fh = open(f, encoding="utf-8", errors="replace")
        except OSError:
            continue
        with fh:
            for line in fh:
                line = line.strip()
                if not line.startswith("{"):
                    continue
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(e, dict):
                    continue
                e = dict((k, _norm_value(v)) for k, v in e.items() if v is not None)
                rt = e.get("__REALTIME_TIMESTAMP", "")
                if not rt.isdigit():
                    t = parse_timestamp(rt, ref) if rt else None
                    if t is None:
                        continue
                    e["__REALTIME_TIMESTAMP"] = str(int(round(t * 1e6)))
                rows.append((int(e["__REALTIME_TIMESTAMP"]), seq, e))
                seq += 1
    rows.sort(key=lambda r: (r[0], r[1]))
    entries = [r[2] for r in rows]
    cur = current_boot_id(entries)
    for e in entries:
        if not e.get("_BOOT_ID"):
            e["_BOOT_ID"] = cur
    return entries


def current_boot_id(entries=None):
    if _BOOT_ID:
        return _BOOT_ID[0]
    b = (read_text(rp(".lm/boot_id"), "") or "").strip()
    if not b:
        if entries is None:
            entries = load_entries_raw_boot()
        for e in reversed(entries):
            if e.get("_BOOT_ID"):
                b = e["_BOOT_ID"]
                break
    if not b:
        b = hashlib.md5(("lm-boot:" + hostname()).encode()).hexdigest()
    _BOOT_ID.append(b)
    return b


def load_entries_raw_boot():
    """Entries (only time and boot id) without filling in defaults."""
    rows = []
    for f in journal_files():
        txt = read_text(f, "") or ""
        for line in txt.splitlines():
            if '"_BOOT_ID"' not in line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            rt = str(e.get("__REALTIME_TIMESTAMP", ""))
            t = int(rt) if rt.isdigit() else int((parse_timestamp(rt, time.time()) or 0) * 1e6)
            rows.append((t, {"_BOOT_ID": str(e.get("_BOOT_ID"))}))
    rows.sort(key=lambda r: r[0])
    return [r[1] for r in rows]


def jlog(message, unit=None, ident="systemd", pid=1, prio=6, sunit=None, transport="journal", extra=None):
    """Append one entry to the runtime journal."""
    e = {"__REALTIME_TIMESTAMP": str(int(now() * 1e6)), "_BOOT_ID": current_boot_id(),
         "PRIORITY": str(prio), "SYSLOG_FACILITY": "3", "SYSLOG_IDENTIFIER": ident,
         "_PID": str(pid), "_HOSTNAME": hostname(), "_TRANSPORT": transport}
    if ident == "systemd" and pid == 1:
        e["_COMM"] = "systemd"
        e["_SYSTEMD_UNIT"] = "init.scope"
    if unit:
        e["UNIT"] = unit
    if sunit:
        e["_SYSTEMD_UNIT"] = sunit
    if extra:
        e.update(extra)
    e["MESSAGE"] = message
    path = rp(RUNTIME_JOURNAL)
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        try:
            os.write(fd, (json.dumps(e) + "\n").encode("utf-8"))
        finally:
            os.close(fd)
    except OSError:
        pass


