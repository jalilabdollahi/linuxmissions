# --------------------------------------------------------------- journalctl

PRIO_NAMES = ["emerg", "alert", "crit", "err", "warning", "notice", "info", "debug"]
MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]


def prio_level(s):
    s = s.strip().lower()
    if s.isdigit() and 0 <= int(s) <= 7:
        return int(s)
    if s in PRIO_NAMES:
        return PRIO_NAMES.index(s)
    return None


def unit_match(e, units):
    for u in units:
        for f in ("_SYSTEMD_UNIT", "UNIT", "OBJECT_SYSTEMD_UNIT", "COREDUMP_UNIT"):
            v = e.get(f)
            if v and (v == u or fnmatch.fnmatchcase(v, u)):
                return True
    return False


def entry_ts(e):
    return int(e["__REALTIME_TIMESTAMP"]) / 1e6


def format_entry(e, mode, utc, show_host=True):
    t = int(e["__REALTIME_TIMESTAMP"])
    sec = t / 1e6
    msg = e.get("MESSAGE", "")
    ident = e.get("SYSLOG_IDENTIFIER") or e.get("_COMM") or "unknown"
    pid = e.get("_PID") or e.get("SYSLOG_PID") or ""
    if e.get("_TRANSPORT") == "kernel":
        ident, pid = "kernel", ""
    host = e.get("_HOSTNAME", hostname())
    d = localdt(sec, utc)
    usec = t % 1000000
    if mode == "short":
        stamp_ = "%s %02d %02d:%02d:%02d" % (MONTHS[d.month - 1], d.day, d.hour, d.minute, d.second)
    elif mode == "short-precise":
        stamp_ = "%s %02d %02d:%02d:%02d.%06d" % (MONTHS[d.month - 1], d.day, d.hour, d.minute, d.second, usec)
    elif mode in ("short-iso", "short-iso-precise"):
        z = d.strftime("%z")
        z = z[:3] + ":" + z[3:] if len(z) == 5 else z
        frac = ".%06d" % usec if mode == "short-iso-precise" else ""
        stamp_ = d.strftime("%Y-%m-%dT%H:%M:%S") + frac + z
    elif mode == "short-full":
        stamp_ = fmt_ts(sec, utc)
    elif mode == "short-unix":
        stamp_ = "%d.%06d" % (t // 1000000, usec)
    elif mode == "short-monotonic":
        mono = int(e.get("__MONOTONIC_TIMESTAMP", "0") or 0)
        stamp_ = "[%5d.%06d]" % (mono // 1000000, mono % 1000000)
    else:
        stamp_ = ""
    prefix = stamp_ + (" " + host if show_host else "") + " " + ident + ("[%s]" % pid if pid else "") + ": "
    lines = msg.split("\n")
    out = [prefix + lines[0]]
    for extra in lines[1:]:
        out.append(" " * len(prefix) + extra)
    return out


class JOpts(object):
