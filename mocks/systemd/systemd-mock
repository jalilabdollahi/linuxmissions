def parse_exec(value):
    """systemd ExecStart= syntax -> dict(prefix, path, argv, ignore, line) or None."""
    v = value.strip()
    prefix = ""
    while v and v[0] in "-@:+!|":
        prefix += v[0]
        v = v[1:]
    try:
        words = shlex.split(v, posix=True)
    except ValueError:
        return None
    if not words:
        return None
    path = words[0]
    argv = words[1:] if "@" in prefix else words
    if "@" in prefix and not argv:
        return None
    return {"prefix": prefix, "path": path, "argv": argv, "ignore": "-" in prefix, "line": v.strip()}


def host_variants(path):
    """/bin/x and /usr/bin/x are the same file on a merged-/usr system (Ubuntu), not on macOS."""
    out = [path]
    for a, b in (("/bin/", "/usr/bin/"), ("/sbin/", "/usr/sbin/")):
        if path.startswith(a):
            out.append(b + path[len(a):])
        elif path.startswith(b):
            out.append(a + path[len(b):])
    return out


def resolve_exec(path):
    """Executable as seen by the fake root -> (real path or None, reason)."""
    if path.startswith("/"):
        real = root_resolve(path)
        if os.path.lexists(rp(path)) or os.path.exists(real):
            return real, None
        if path.startswith(HOST_FALLBACK_DIRS):
            for cand in host_variants(path):
                if os.path.exists(cand):
                    return cand, None
        return None, "missing"
    for d in FIXED_PATH.split(":"):
        real = root_resolve(d + "/" + path)
        if os.path.isfile(real) and os.access(real, os.X_OK):
            return real, None
    for d in FIXED_PATH.split(":"):
        cand = d + "/" + path
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand, None
    return None, "missing"


class Unit(object):
    def __init__(self, rec):
        self.rec = rec
        self.name = rec["name"]
        self.type = unit_type(self.name)
        self.template, self.instance = split_instance(self.name)
        self.state = rec["state"]
        self.fragment = rec.get("fragment")
        self.files = rec.get("files", [])
        self.dropins = [f[0] for f in self.files[1:]]
        self.assign = []
        self.warnings = []
        self.errors = []
        for path, text in self.files:
            for sec, key, val, lineno in parse_ini(text):
                if key is None:
                    if sec not in ("Unit", "Install", "Service") and sec not in FREE_SECTIONS \
                            and not sec.startswith("X-"):
                        self.warnings.append("%s:%d: Unknown section '%s'. Ignoring." % (path, lineno, sec))
                    continue
                if sec is None:
                    self.warnings.append("%s:%d: Assignment outside of section. Ignoring." % (path, lineno))
                    continue
                if val is None:
                    self.warnings.append("%s:%d: Missing '=', ignoring line." % (path, lineno))
                    continue
                if not self._known(sec, key):
                    if not sec.startswith("X-") and not key.startswith("X-"):
                        self.warnings.append("%s:%d: Unknown key name '%s' in section '%s', ignoring."
                                             % (path, lineno, key, sec))
                    continue
                self.assign.append((sec, key, self.expand(val), path, lineno))
        self.load_state = {"ok": "loaded", "builtin": "loaded", "masked": "masked",
                           "not-found": "not-found"}[self.state]
        if self.load_state == "loaded" and self.type == "service":
            self._validate_service()
        if self.errors:
            self.load_state = "bad-setting"

    def _known(self, sec, key):
        if sec == "Unit":
            return key in UNIT_KEYS or key.startswith(("Condition", "Assert"))
        if sec == "Install":
            return key in INSTALL_KEYS
        if sec == "Service":
            return key in SERVICE_KEYS or key in EXEC_KEYS or key.startswith(EXEC_PREFIX_KEYS)
        if sec in FREE_SECTIONS:
            return True
        return False

    def expand(self, v):
        tmpl_prefix = self.name.split("@")[0] if "@" in self.name else self.name.rsplit(".", 1)[0]
        table = {"n": self.name, "N": self.name.rsplit(".", 1)[0], "p": tmpl_prefix,
                 "i": self.instance or "", "I": self.instance or "", "j": tmpl_prefix.split("-")[-1],
                 "f": "/" + (self.instance or tmpl_prefix), "h": "/root", "u": "root", "U": "0",
                 "t": "/run", "S": "/var/lib", "C": "/var/cache", "L": "/var/log", "E": "/etc",
                 "T": "/tmp", "V": "/var/tmp", "H": hostname(), "l": hostname().split(".")[0], "%": "%"}
        if "%" not in v:
            return v
        return re.sub(r"%(.)", lambda m: table.get(m.group(1), m.group(0)), v)

    # ---- values
    def values(self, sec, key):
        res = []
        for s, k, v, _p, _l in self.assign:
            if s == sec and k == key:
                if v == "" and key in LIST_KEYS:
                    res = []
                else:
                    res.append(v)
        return res

    def get(self, sec, key, default=None):
        vals = [v for s, k, v, _p, _l in self.assign if s == sec and k == key]
        return vals[-1] if vals else default

    def svc(self, key, default=None):
        return self.get("Service", key, default)

    def deps(self, key, sec="Unit"):
        out = []
        for v in self.values(sec, key):
            for w in v.split():
                w = mangle(w)
                if w not in out:
                    out.append(w)
        return out

    def where(self, sec, key):
        for s, k, _v, p, ln in reversed(self.assign):
            if s == sec and k == key:
                return p, ln
        return self.fragment, 0

    def description(self):
        return self.get("Unit", "Description") or self.name

    def bool(self, sec, key, default=False):
        v = self.get(sec, key)
        if v is None:
            return default
        return v.lower() in ("1", "yes", "true", "on")

    def stype(self):
        t = self.svc("Type")
        if t is None or t not in SERVICE_TYPES:
            if self.svc("BusName"):
                return "dbus"
            return "simple"
        return t

    def restart(self):
        r = self.svc("Restart", "no")
        return r if r in RESTART_VALUES else "no"

    def execs(self, key):
        out = []
        for v in self.values("Service", key):
            c = parse_exec(v)
            if c:
                out.append(c)
        return out

    def timespan(self, key, default, sec="Service"):
        v = self.get(sec, key)
        if v is None:
            return default
        t = parse_timespan(v)
        return default if t is None else t

    def start_limit(self):
        interval = self.get("Unit", "StartLimitIntervalSec") or self.svc("StartLimitIntervalSec") \
            or self.svc("StartLimitInterval")
        iv = parse_timespan(interval) if interval else 10.0
        burst = self.get("Unit", "StartLimitBurst") or self.svc("StartLimitBurst") or "5"
        try:
            b = int(burst)
        except ValueError:
            b = 5
        return (10.0 if iv is None else iv), b

    def install_info(self):
        return any(self.values("Install", k) for k in ("WantedBy", "RequiredBy", "UpheldBy", "Alias", "Also")) \
            or (self.template and self.get("Install", "DefaultInstance"))

    def _validate_service(self):
        t = self.svc("Type")
        if t is not None and t not in SERVICE_TYPES:
            p, ln = self.where("Service", "Type")
            self.warnings.append("%s:%d: Failed to parse service type, ignoring: %s" % (p, ln, t))
        r = self.svc("Restart")
        if r is not None and r not in RESTART_VALUES:
            p, ln = self.where("Service", "Restart")
            self.warnings.append("%s:%d: Failed to parse service restart specifier, ignoring: %s" % (p, ln, r))
        for key in ("ExecStart", "ExecStartPre", "ExecStartPost", "ExecStop", "ExecStopPost", "ExecReload",
                    "ExecCondition"):
            for s, k, v, p, ln in self.assign:
                if s != "Service" or k != key or v == "":
                    continue
                c = parse_exec(v)
                if c is None:
                    self.errors.append("%s:%d: Invalid command line, ignoring: %s" % (p, ln, v))
                    continue
                path = c["path"]
                if path.startswith("/"):
                    continue
                if "/" in path:
                    self.errors.append("%s:%d: Neither a valid executable name nor an absolute path: %s"
                                       % (p, ln, path))
                    continue
                real, _ = resolve_exec(path)
                if real is None:
                    self.errors.append('%s:%d: Executable "%s" not found in path "%s"' % (p, ln, path, FIXED_PATH))
        starts = self.values("Service", "ExecStart")
        st = self.stype()
        if len(starts) > 1 and st != "oneshot":
            self.errors.append("%s: Service has more than one ExecStart= setting, which is only allowed "
                               "for Type=oneshot services. Refusing." % self.name)
        if not starts and not self.values("Service", "ExecStop") and st != "oneshot":
            self.errors.append("%s: Service has no ExecStart=, ExecStop=, or SuccessAction=. Refusing." % self.name)
        elif not starts and st == "oneshot" and not self.values("Service", "ExecStop"):
            self.errors.append("%s: Service has no ExecStart=, ExecStop=, or SuccessAction=. Refusing." % self.name)
        wd = self.svc("WorkingDirectory")
        if wd and not wd.lstrip("-").startswith("/") and wd.lstrip("-") != "~":
            p, ln = self.where("Service", "WorkingDirectory")
            self.warnings.append("%s:%d: WorkingDirectory= path is not absolute, ignoring: %s" % (p, ln, wd))


