DEFAULT_STATE = {"ActiveState": "inactive", "SubState": "dead", "Result": "success", "MainPID": "0",
                 "ExecMainPID": "0", "ExecMainCode": "0", "ExecMainStatus": "0", "NRestarts": "0"}
CODE_NAMES = {"0": "", "1": "exited", "2": "killed", "3": "dumped",
              "exited": "exited", "killed": "killed", "dumped": "dumped", "": ""}
CODE_NUMS = {"exited": "1", "killed": "2", "dumped": "3"}


def state_file(name):
    return os.path.join(state_dir(), "units", name + ".state")


def read_state(name):
    st = dict(DEFAULT_STATE)
    txt = read_text(state_file(name))
    if txt:
        for line in txt.splitlines():
            if "=" in line and not line.startswith("#"):
                k, v = line.split("=", 1)
                st[k.strip()] = v.strip()
    st["ExecMainCode"] = CODE_NUMS.get(st.get("ExecMainCode", "0"), st.get("ExecMainCode", "0"))
    return st


def write_state(name, st):
    lines = ["%s=%s" % (k, st[k]) for k in sorted(st)]
    write_atomic(state_file(name), "\n".join(lines) + "\n")


def update_state(name, **kw):
    with Lock():
        st = read_state(name)
        st.update(dict((k, str(v)) for k, v in kw.items()))
        write_state(name, st)
        return st


def stamp():
    return "@%.6f" % now()


def st_time(st, key):
    v = st.get(key, "")
    if not v:
        return None
    return parse_timestamp(v, now())


def pid_alive(pid):
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    try:
        with open("/proc/%d/stat" % pid) as fh:
            return fh.read().rsplit(")", 1)[1].split()[0] != "Z"
    except (OSError, IndexError):
        pass
    try:
        out = subprocess.run(["ps", "-o", "stat=", "-p", str(pid)], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, universal_newlines=True).stdout.strip()
    except OSError:
        return True
    return bool(out) and not out.startswith("Z")


def live_state(name):
    """State with stale 'running' entries (supervisor gone) cleaned up."""
    st = read_state(name)
    sup = st.get("LMSupervisorPID", "")
    if sup and st["ActiveState"] in ("active", "activating", "deactivating", "reloading") \
            and not pid_alive(sup) and not pid_alive(st.get("MainPID", "0")):
        st = update_state(name, ActiveState="failed", SubState="failed", Result="signal", MainPID="0",
                          LMSupervisorPID="", LMJob="", StateChangeTimestamp=stamp())
    return st


def eff_state(name):
    """live_state(), but targets in the default target's tree count as reached."""
    st = live_state(name)
    if unit_type(name) == "target" and not os.path.exists(state_file(name)) and name in boot_closure():
        st = dict(st)
        st["ActiveState"], st["SubState"] = "active", "active"
    return st


def proc_table():
    try:
        out = subprocess.run(["ps", "-A", "-o", "pid=,pgid=,args="], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, universal_newlines=True).stdout
    except OSError:
        return []
    rows = []
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
            rows.append((int(parts[0]), int(parts[1]), parts[2] if len(parts) > 2 else ""))
    return rows


def comm_of(pid):
    txt = read_text("/proc/%s/comm" % pid)
    if txt:
        return txt.strip()
    try:
        out = subprocess.run(["ps", "-o", "comm=", "-p", str(pid)], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, universal_newlines=True).stdout.strip()
        return os.path.basename(out) or "?"
    except OSError:
        return "?"


