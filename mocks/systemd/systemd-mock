def table(rows, right=()):
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    out = []
    for r in rows:
        cells = []
        for i, c in enumerate(r):
            if i == len(r) - 1:
                cells.append(c)
            elif i in right:
                cells.append(c.rjust(widths[i]))
            else:
                cells.append(c.ljust(widths[i]))
        out.append(" ".join(cells).rstrip())
    return out


def match_patterns(name, pats):
    return not pats or any(fnmatch.fnmatchcase(name, p) or fnmatch.fnmatchcase(name, mangle(p)) for p in pats)


def cmd_list_units(o, args):
    states = list(o.states)
    if o.failed:
