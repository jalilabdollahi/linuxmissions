class Fail(Exception):
    """Print msg to stderr and exit with code."""

    def __init__(self, msg, code=1):
        Exception.__init__(self, msg)
        self.msg = msg
        self.code = code


def err(msg):
    sys.stderr.write(msg + "\n")


def unsupported(what):
    raise Fail("mock: %s not supported" % what, 1)


# --------------------------------------------------------------------- paths

def find_root():
    env = os.environ.get("LM_ROOT")
    if env:
        return os.path.abspath(env)
    cur = os.path.dirname(os.path.abspath(sys.argv[0]))
    while os.path.basename(cur) in ("bin", "sbin", "usr", "local") and not os.path.isdir(os.path.join(cur, "etc")):
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent
    return cur


def rp(path):
    """Fake-root path ('/etc/x' or 'etc/x') -> real path."""
    return os.path.join(ROOT, path.lstrip("/"))


def disp(real):
    """Real path inside ROOT -> path as seen from inside the fake root."""
    rel = os.path.relpath(real, ROOT)
    return "/" if rel == "." else "/" + rel


def root_resolve(path):
    """Resolve an absolute fake-root path, following symlinks inside ROOT
    (absolute link targets are read relative to ROOT, as a chroot would)."""
    parts = [p for p in path.split("/") if p and p != "."]
    done = []
    hops = 0
    while parts:
        p = parts.pop(0)
        if p == "..":
            if done:
                done.pop()
            continue
        cand = os.path.join(ROOT, *(done + [p]))
        if os.path.islink(cand):
            hops += 1
            if hops > 40:
                return cand
            target = os.readlink(cand)
            if target.startswith("/"):
                done = []
            parts = [x for x in target.split("/") if x and x != "."] + parts
            continue
        done.append(p)
    return os.path.join(ROOT, *done) if done else ROOT


def read_text(path, default=None):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return default


def write_atomic(path, text):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    tmp = "%s.tmp.%d" % (path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.replace(tmp, path)


# --------------------------------------------------------------------- clock

_TZ = None


def tz_from_name(name):
    if name in ("UTC", "Etc/UTC", "GMT", "Etc/GMT", "Z", "Etc/Universal", "Universal", "Zulu"):
        return timezone.utc
    m = re.match(r"^(?:UTC|GMT)?([+-])(\d{1,2}):?(\d{2})?$", name)
    if m:
        mins = int(m.group(2)) * 60 + int(m.group(3) or 0)
        if m.group(1) == "-":
            mins = -mins
        label = "%s%02d%02d" % (m.group(1), abs(mins) // 60, abs(mins) % 60)
        return timezone(timedelta(minutes=mins), label)
    try:
        from zoneinfo import ZoneInfo
        return ZoneInfo(name)
    except Exception:
        return None


def tz_name():
    name = os.environ.get("LM_TZ", "").strip()
    if not name:
        txt = read_text(rp("etc/timezone"), "")
        name = txt.strip().split("\n")[0].strip() if txt else ""
    if not name:
        lt = rp("etc/localtime")
        if os.path.islink(lt):
            target = os.readlink(lt)
            i = target.find("zoneinfo/")
            if i >= 0:
                name = target[i + 9:]
    return name or "Etc/UTC"


def get_tz():
    global _TZ
    if _TZ is None:
        _TZ = tz_from_name(tz_name()) or timezone.utc
    return _TZ


def clock_spec():
    s = os.environ.get("LM_NOW", "").strip()
    if not s:
        s = (read_text(rp(".lm/now"), "") or "").strip()
    return s


_NOW_CACHE = []


def now():
    if _NOW_CACHE:
        return _NOW_CACHE[0]
    spec = clock_spec()
    if spec:
        t = parse_timestamp(spec, time.time())
        if t is not None:
            _NOW_CACHE.append(t)
            return t
    return time.time()


def localdt(ts, utc=False):
    return datetime.fromtimestamp(ts, timezone.utc if utc else get_tz())


def tzabbr(d):
    name = d.tzname()
    if not name or name.startswith("UTC+") or name.startswith("UTC-"):
        name = d.strftime("%z")
    return name


def fmt_ts(ts, utc=False):
    """'Tue 2026-11-10 03:04:05 UTC' like systemd's format_timestamp()."""
    if ts is None:
        return ""
    d = localdt(ts, utc)
    return d.strftime("%a %Y-%m-%d %H:%M:%S ") + tzabbr(d)


USEC_MIN = 60 * 10**6
SPAN_UNITS = {
    "us": 1e-6, "usec": 1e-6, "\u00b5s": 1e-6, "ms": 1e-3, "msec": 1e-3,
    "s": 1, "sec": 1, "second": 1, "seconds": 1,
    "m": 60, "min": 60, "minute": 60, "minutes": 60,
    "h": 3600, "hr": 3600, "hour": 3600, "hours": 3600,
    "d": 86400, "day": 86400, "days": 86400,
    "w": 604800, "week": 604800, "weeks": 604800,
    "M": 2629800, "month": 2629800, "months": 2629800,
    "y": 31557600, "year": 31557600, "years": 31557600,
}


def parse_timespan(s, default_unit=1.0):
    """'1h 30min', '500ms', '5' -> seconds (float). None if invalid."""
    s = s.strip()
    if s == "infinity":
        return float("inf")
    if not s:
        return None
    total = 0.0
    pos = 0
    rx = re.compile(r"\s*(\d+(?:\.\d*)?)\s*([A-Za-z\u00b5]*)")
    while pos < len(s):
        m = rx.match(s, pos)
        if not m or m.end() == pos:
            return None
        num, unit = m.group(1), m.group(2)
        if unit:
            if unit not in SPAN_UNITS:
                return None
            total += float(num) * SPAN_UNITS[unit]
        else:
            total += float(num) * default_unit
        pos = m.end()
        while pos < len(s) and s[pos].isspace():
            pos += 1
    return total


TS_TABLE = [("y", 31557600 * 10**6), ("month", 2629800 * 10**6), ("w", 604800 * 10**6),
            ("d", 86400 * 10**6), ("h", 3600 * 10**6), ("min", 60 * 10**6), ("s", 10**6),
            ("ms", 1000), ("us", 1)]


def format_timespan(usec, accuracy=1):
    """systemd's format_timespan(): '2min 28.871s', '330ms', 'infinity'."""
    if usec is None or usec == float("inf"):
        return "infinity"
    usec = int(usec)
    if usec <= 0:
        return "0"
    accuracy = max(1, accuracy)
    out = []
    t = usec
    something = False
    for suffix, unit in TS_TABLE:
        if t <= 0:
            break
        if t < accuracy and something:
            break
        if t < unit:
            continue
        a, b = divmod(t, unit)
        done = False
        if t < USEC_MIN and b > 0:
            j = 0
            cc = unit
            while cc > 1:
                j += 1
                cc //= 10
            cc = accuracy
            while cc > 1:
                b //= 10
                j -= 1
                cc //= 10
            if j > 0:
                out.append("%d.%0*d%s" % (a, j, b, suffix))
                t = 0
                done = True
        if not done:
            out.append("%d%s" % (a, suffix))
            t = b
        something = True
    return " ".join(out) if out else "0"


def fmt_rel(ts, ref=None):
    """systemd's format_timestamp_relative(): '5min ago', '1 day 2h ago'."""
    if ref is None:
        ref = now()
    d = int(round((ref - ts) * 1e6))
    suffix = "ago" if d >= 0 else "left"
    d = abs(d)
    S = 10**6
    MIN = 60 * S
    H = 60 * MIN
    D = 24 * H
    W = 7 * D
    MON = 2629800 * S
    Y = 31557600 * S

    def pl(n, one, many):
        return "%d %s" % (n, one if n == 1 else many)
    if d >= Y:
        return "%s %s %s" % (pl(d // Y, "year", "years"), pl((d % Y) // MON, "month", "months"), suffix)
    if d >= MON:
        return "%s %s %s" % (pl(d // MON, "month", "months"), pl((d % MON) // D, "day", "days"), suffix)
    if d >= W:
        return "%s %s %s" % (pl(d // W, "week", "weeks"), pl((d % W) // D, "day", "days"), suffix)
    if d >= 2 * D:
        return "%d days %s" % (d // D, suffix)
    if d >= 25 * H:
        return "1 day %dh %s" % ((d - D) // H, suffix)
    if d >= 6 * H:
        return "%dh %s" % (d // H, suffix)
    if d >= H:
        return "%dh %dmin %s" % (d // H, (d % H) // MIN, suffix)
    if d >= 5 * MIN:
        return "%dmin %s" % (d // MIN, suffix)
    if d >= MIN:
        return "%dmin %ds %s" % (d // MIN, (d % MIN) // S, suffix)
    if d >= S:
        return "%ds %s" % (d // S, suffix)
    if d >= 1000:
        return "%dms %s" % (d // 1000, suffix)
    if d > 0:
        return "%dus %s" % (d, suffix)
    return "now"


WEEKDAYS = {"mon", "tue", "wed", "thu", "fri", "sat", "sun", "monday", "tuesday", "wednesday",
            "thursday", "friday", "saturday", "sunday"}


def parse_timestamp(spec, ref):
    """systemd.time(7) timestamps -> epoch seconds, None if invalid."""
    s = spec.strip()
    if not s:
        return None
    tz = get_tz()
    if s == "now":
        return ref
    if s in ("today", "yesterday", "tomorrow"):
        d = localdt(ref).date() + timedelta(days={"today": 0, "yesterday": -1, "tomorrow": 1}[s])
        return datetime(d.year, d.month, d.day, tzinfo=tz).timestamp()
    if s == "epoch":
        return 0.0
    if s.startswith("@"):
        try:
            return float(s[1:])
        except ValueError:
            return None
    if s[0] in "+-":
        span = parse_timespan(s[1:])
        if span is None:
            return None
        return ref + span if s[0] == "+" else ref - span
    m = re.match(r"^(.+?)\s+(ago|left)$", s)
    if m:
        span = parse_timespan(m.group(1))
        if span is None:
            return None
        return ref - span if m.group(2) == "ago" else ref + span
    m = re.match(r"^(.*\d)\s*(Z|[+-]\d\d:?\d\d)$", s)
    if m and ":" in m.group(1):
        s = m.group(1)
        tz = tz_from_name("UTC" if m.group(2) == "Z" else m.group(2))
    else:
        m = re.match(r"^(.*\S)\s+([A-Za-z][A-Za-z0-9_+/-]*)$", s)
        if m and m.group(2).lower() not in WEEKDAYS:
            z = tz_from_name(m.group(2))
            if z is None:
                return None
            s, tz = m.group(1), z
    m = re.match(r"^([A-Za-z]+),?\s+(.*)$", s)
    if m:
        if m.group(1).lower() not in WEEKDAYS:
            return None
        s = m.group(2)
    m = re.match(r"^(\d{4}|\d{2})-(\d{1,2})-(\d{1,2})(?:[ T](\d{1,2}):(\d{2})(?::(\d{2})(?:\.(\d{1,6}))?)?)?$", s)
    if m:
        y = int(m.group(1))
        if len(m.group(1)) == 2:
            y += 2000 if y < 69 else 1900
        mo, da = int(m.group(2)), int(m.group(3))
        hh, mi, ss, frac = m.group(4), m.group(5), m.group(6), m.group(7)
    else:
        m = re.match(r"^(\d{1,2}):(\d{2})(?::(\d{2})(?:\.(\d{1,6}))?)?$", s)
        if not m:
            return None
        d = datetime.fromtimestamp(ref, tz).date()
        y, mo, da = d.year, d.month, d.day
        hh, mi, ss, frac = m.group(1), m.group(2), m.group(3), m.group(4)
    try:
        dt = datetime(y, mo, da, int(hh or 0), int(mi or 0), int(ss or 0),
                      int((frac or "0").ljust(6, "0")), tzinfo=tz)
    except ValueError:
        return None
    return dt.timestamp()


def parse_bytes(v):
    """systemd parse_size(): '1.5G' -> bytes (base 1024). None if invalid."""
    v = v.strip()
    if v == "infinity":
        return "infinity"
    m = re.match(r"^(\d+(?:\.\d+)?)\s*([KMGTPE]?)B?$", v)
    if not m:
        return None
    mult = 1024 ** " KMGTPE".index(m.group(2) or " ")
    return int(float(m.group(1)) * mult)


