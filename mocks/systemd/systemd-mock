    if os.path.lexists(link):
        os.unlink(link)
        print('Removed "/etc/systemd/system/default.target".')
    os.makedirs(os.path.dirname(link), exist_ok=True)
    os.symlink(frag, link)
    print("Created symlink /etc/systemd/system/default.target \u2192 %s." % frag)
    daemon_reload()
    return 0


