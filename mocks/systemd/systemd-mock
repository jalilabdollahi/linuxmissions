def cmd_set_property(o, args):
    if len(args) < 2:
        raise Fail("Too few arguments.")
    name = resolve_alias(mangle(args[0]))
    u = get_unit(name)
    if u.load_state == "not-found":
        raise Fail("Failed to set unit properties on %s: Unit %s not found." % (name, name))
    sec = SECTION_FOR.get(u.type)
    if sec is None:
        raise Fail("Failed to set unit properties on %s: Cannot set property, or unknown property." % name)
    base = "/run/systemd/system.control" if o.runtime else "/etc/systemd/system.control"
    new_files = []
    for a in args[1:]:
        if "=" not in a:
            raise Fail("Failed to parse property assignment: %s" % a)
        k, v = a.split("=", 1)
        if k not in SET_PROPERTY_OK:
            raise Fail("Failed to set unit properties on %s: Cannot set property %s, or unknown property." % (name, k))
        val = v
        if k.startswith("Memory") and k not in ("MemoryAccounting",):
            if v.endswith("%"):
                val = v
            else:
                b = parse_bytes(v)
                if b is None:
                    raise Fail("Failed to parse %s value %s" % (k, v))
                val = str(b)
        if k == "MemoryLimit":
            k = "MemoryMax"
        path = "%s/%s.d/50-%s.conf" % (base, name, k)
        text = ("# This is a drop-in unit file extension, created via \"systemctl set-property\"\n"
                "# or an equivalent operation. Do not edit.\n[%s]\n%s=%s\n" % (sec, k, val))
        write_atomic(rp(path), text)
        new_files.append([path, text])
    with Lock():
        snap = load_snapshot()
        rec = snap.get(name) or disk_record(name)
        frag = rec["files"][:1]
        drops = [f for f in rec["files"][1:] if f[0] not in [n[0] for n in new_files]] + new_files
        drops.sort(key=lambda f: f[0].rsplit("/", 1)[1])
        rec["files"] = frag + drops
        snap[name] = rec
        save_snapshot(snap)
    _UNIT_CACHE.pop(name, None)
    return 0


