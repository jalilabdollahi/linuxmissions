def state_dir():
    return rp(".lm/systemd")


class Lock(object):
    def __enter__(self):
        os.makedirs(state_dir(), exist_ok=True)
        self.fh = open(os.path.join(state_dir(), "lock"), "a")
        fcntl.flock(self.fh, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


def snapshot_path():
    return os.path.join(state_dir(), "loaded.json")


def load_snapshot():
    txt = read_text(snapshot_path())
    if not txt:
        return {}
    try:
        return json.loads(txt)
    except ValueError:
        return {}


def save_snapshot(snap):
    write_atomic(snapshot_path(), json.dumps(snap, sort_keys=True))


_UNIT_CACHE = {}


def get_unit(name):
    """The unit as the (mock) manager has it loaded."""
    if name in _UNIT_CACHE:
        return _UNIT_CACHE[name]
    with Lock():
        snap = load_snapshot()
        rec = snap.get(name)
        if rec is None:
            rec = disk_record(name)
            snap[name] = rec
            save_snapshot(snap)
            u = Unit(rec)
            log_load_problems(u)
        else:
            u = Unit(rec)
    _UNIT_CACHE[name] = u
    return u


def disk_unit(name):
    return Unit(disk_record(name))


def changed_on_disk(name):
    snap = load_snapshot()
    rec = snap.get(name)
    if rec is None:
        return False
    return disk_record(name) != rec


def warn_changed(name):
    if changed_on_disk(name):
        err("Warning: The unit file, source configuration file or drop-ins of %s changed on disk. "
            "Run 'systemctl daemon-reload' to reload units." % name)


def log_load_problems(u):
    for w in u.warnings:
        jlog(w, unit=u.name, prio=4)
    for e in u.errors:
        jlog(e, unit=u.name, prio=3)
    if u.errors:
        jlog("%s: Unit configuration has fatal error, unit will not be started." % u.name, unit=u.name, prio=3)


def units_on_disk():
    names = set()
    for real_dir, _d in unit_dirs():
        try:
            entries = os.listdir(real_dir)
        except OSError:
            continue
        for e in entries:
            if e.endswith(UNIT_SUFFIXES) and not os.path.isdir(os.path.join(real_dir, e)):
                names.add(e)
    return names


def wants_dir(name, kind):
    out = []
    for real_dir, _d in unit_dirs():
        d = os.path.join(real_dir, "%s.%s" % (name, kind))
        try:
            entries = sorted(os.listdir(d))
        except OSError:
            continue
        for e in entries:
            if e.endswith(UNIT_SUFFIXES) and e not in out:
                out.append(e)
    return out


def wants_dir_units():
    names = set()
    for real_dir, _d in unit_dirs():
        try:
            entries = os.listdir(real_dir)
        except OSError:
            continue
        for e in entries:
            if e.endswith((".wants", ".requires", ".upholds")):
                try:
                    names.update(x for x in os.listdir(os.path.join(real_dir, e)) if x.endswith(UNIT_SUFFIXES))
                except OSError:
                    pass
    return names


def state_names():
    d = os.path.join(state_dir(), "units")
    try:
        return set(f[:-6] for f in os.listdir(d) if f.endswith(".state"))
    except OSError:
        return set()


def all_unit_names():
    names = units_on_disk() | set(BUILTIN) | state_names() | wants_dir_units() | set(load_snapshot())
    return sorted(n for n in names if not (split_instance(n)[0] and split_instance(n)[1] == ""))


def daemon_reload(log=True):
    with Lock():
        old = load_snapshot()
        names = units_on_disk() | set(old) | state_names() | wants_dir_units()
        snap = {}
        for n in sorted(names):
            if split_instance(n)[0] and split_instance(n)[1] == "":
                continue
            snap[n] = disk_record(n)
        save_snapshot(snap)
    _UNIT_CACHE.clear()
    if log:
        jlog("Reloading requested from client PID %d ('systemctl')..." % os.getpid())
        jlog("Reloading...")
    for n in sorted(snap):
        if snap[n]["state"] == "ok":
            u = Unit(snap[n])
            if u.warnings or u.errors:
                log_load_problems(u)
    if log:
        jlog("Reloading finished in 112 ms.")


