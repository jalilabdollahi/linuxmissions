def journalctl_main(argv):
    o = JOpts()
    o.units, o.idents, o.xidents = [], [], []
    o.prio = None
    o.since = o.until = None
    o.grep = None
    o.case = None
    o.lines = None
    o.reverse = False
    o.output = "short"
    o.utc = False
    o.host = True
    o.quiet = False
    o.boot = None
    o.kernel = False
    o.list_boots = False
    o.field = None
    o.fields = False
    o.files = None
    o.matches = []
    o.disk_usage = False
    i = 0
    argv = list(argv)
    with_arg = {"-u": "unit", "--unit": "unit", "-p": "prio", "--priority": "prio", "-S": "since", "--since": "since",
                "-U": "until", "--until": "until", "-g": "grep", "--grep": "grep", "-o": "output", "--output": "output",
                "-t": "ident", "--identifier": "ident", "-T": "xident", "--exclude-identifier": "xident",
                "-F": "field", "--field": "field", "--file": "file"}

    def boot_arg_ok(s):
        return bool(re.match(r"^([-+]?\d+|[0-9a-fA-F]{32}([-+]\d+)?|all)$", s))
    while i < len(argv):
        a = argv[i]
        i += 1
        if not a.startswith("-") or a == "-":
            if a == "+":
                o.matches.append("+")
            elif "=" in a and re.match(r"^[A-Z0-9_]+=", a):
                o.matches.append(a)
            else:
                unsupported("journalctl match '%s' (use FIELD=VALUE or -u UNIT) is" % a)
            continue
        key, val = a, None
        if a.startswith("--") and "=" in a:
            key, val = a.split("=", 1)
        elif not a.startswith("--") and len(a) > 2:
            if a[:2] in with_arg or a[:2] in ("-n", "-b"):
                key, val = a[:2], a[2:]
            elif all(c in "xeqrkalm" for c in a[1:]):
                for c in reversed(a[1:]):
                    argv.insert(i, "-" + c)
                continue
        if key in with_arg:
            if val is None:
                if i >= len(argv):
                    raise Fail("journalctl: option '%s' requires an argument" % key)
                val = argv[i]
                i += 1
            dest = with_arg[key]
            if dest == "unit":
                o.units.append(resolve_alias(mangle(val)) if not any(c in val for c in "*?[") else val)
            elif dest == "prio":
                o.prio = val
            elif dest == "since":
                o.since = val
            elif dest == "until":
                o.until = val
            elif dest == "grep":
                o.grep = val
            elif dest == "output":
                o.output = val
            elif dest == "ident":
                o.idents.append(val)
            elif dest == "xident":
                o.xidents.append(val)
            elif dest == "field":
                o.field = val
            elif dest == "file":
                o.files = (o.files or []) + (glob.glob(val) or [val])
            continue
        if key in ("-n", "--lines"):
            if val is None and i < len(argv) and re.match(r"^(\+?\d+|all)$", argv[i]):
                val = argv[i]
                i += 1
            if val is None or val == "":
                o.lines = 10
            elif val == "all":
                o.lines = None
            elif re.match(r"^\+?\d+$", val):
                o.lines = ("+", int(val[1:])) if val.startswith("+") else int(val)
            else:
                raise Fail("Failed to parse lines '%s'" % val)
        elif key in ("-b", "--boot"):
            if val is None and i < len(argv) and boot_arg_ok(argv[i]):
                val = argv[i]
                i += 1
            o.boot = val if val not in (None, "") else "0"
        elif key in ("-k", "--dmesg"):
            o.kernel = True
        elif key in ("-r", "--reverse"):
            o.reverse = True
        elif key in ("-e", "--pager-end"):
            if o.lines is None:
                o.lines = 1000
        elif key in ("-q", "--quiet"):
            o.quiet = True
        elif key == "--utc":
            o.utc = True
        elif key == "--no-hostname":
            o.host = False
        elif key == "--list-boots":
            o.list_boots = True
        elif key in ("-N", "--fields"):
            o.fields = True
        elif key == "--case-sensitive":
            o.case = val not in ("no", "false", "0")
        elif key == "--disk-usage":
            o.disk_usage = True
        elif key in ("--no-pager", "-x", "--catalog", "-a", "--all", "-l", "--full", "--system", "--no-full",
                     "--no-tail", "--show-cursor"):
            pass
        elif key == "--version":
            print(VERSION_TEXT)
            return 0
        elif key in ("-h", "--help"):
            print("journalctl [OPTIONS...] [MATCHES...]\n\nMock of journalctl for LinuxMissions; see mocks/README.md.")
            return 0
        elif key in JOURNAL_UNSUPPORTED:
            unsupported("option %s" % key)
        elif key.startswith("--"):
            raise Fail("journalctl: unrecognized option '%s'" % key)
        else:
            raise Fail("journalctl: invalid option -- '%s'" % key.lstrip("-")[:1])

    modes = ("short", "short-precise", "short-iso", "short-iso-precise", "short-full", "short-unix",
             "short-monotonic", "cat", "json", "json-pretty", "json-sse", "json-seq", "verbose", "export",
             "with-unit")
    if o.output not in modes:
        raise Fail("Unknown output format '%s'." % o.output)
    if o.output in ("json-sse", "json-seq", "export", "with-unit"):
        unsupported("output mode '%s'" % o.output)
    ref = now()
    entries = load_entries(o.files)
    if o.disk_usage:
        size = sum(os.path.getsize(f) for f in (o.files or journal_files()) if os.path.exists(f))
        print("Archived and active journals take up %s in the file system." % human_size(size))
        return 0
    boots = []
    for e in entries:
        b = e.get("_BOOT_ID")
        if b not in [x[0] for x in boots]:
            boots.append([b, entry_ts(e), entry_ts(e)])
        else:
            for x in boots:
                if x[0] == b:
                    x[2] = entry_ts(e)
    boots.sort(key=lambda x: x[1])
    cur = current_boot_id(entries)
    ids = [b[0] for b in boots]
    cur_idx = ids.index(cur) if cur in ids else len(ids) - 1
    if o.list_boots:
        if not boots:
            raise Fail("No boot found.")
        rows = [("IDX", "BOOT ID", "FIRST ENTRY", "LAST ENTRY")]
        for k, b in enumerate(boots):
            rows.append((str(k - cur_idx), b[0], fmt_ts(b[1], o.utc), fmt_ts(b[2], o.utc)))
        for line in table(rows, right=(0,)):
            print(line)
        return 0
    if o.kernel and o.boot is None:
        o.boot = "0"
    boot_id = None
    if o.boot is not None and o.boot != "all":
        m = re.match(r"^([0-9a-fA-F]{32})?([-+]?\d+)?$", o.boot)
        if not m:
            raise Fail("Failed to parse boot descriptor '%s'" % o.boot)
        if m.group(1):
            if m.group(1).lower() not in ids:
                raise Fail("No journal boot entry found from the specified boot (%s)." % o.boot)
            k = ids.index(m.group(1).lower()) + int(m.group(2) or 0)
        else:
            off = int(m.group(2) or 0)
            k = cur_idx + off if off <= 0 else off - 1
        if not (0 <= k < len(ids)):
            raise Fail("No journal boot entry found from the specified boot offset (%s)." % o.boot)
        boot_id = ids[k]
    pmin, pmax = 0, 7
    if o.prio is not None:
        if ".." in o.prio:
            a, b = o.prio.split("..", 1)
            la = prio_level(a) if a else 0
            lb = prio_level(b) if b else 7
            if la is None or lb is None:
                raise Fail("Failed to parse log level range %s" % o.prio)
            pmin, pmax = min(la, lb), max(la, lb)
        else:
            lv = prio_level(o.prio)
            if lv is None:
                raise Fail("Unknown log level %s" % o.prio)
            pmax = lv
    t_from = t_to = None
    if o.since is not None:
        t_from = parse_timestamp(o.since, ref)
        if t_from is None:
            raise Fail("Failed to parse timestamp: %s" % o.since)
    if o.until is not None:
        t_to = parse_timestamp(o.until, ref)
        if t_to is None:
            raise Fail("Failed to parse timestamp: %s" % o.until)
    if t_from is not None and t_to is not None and t_from > t_to:
        raise Fail("--since= must be before --until=.")
    rx = None
    if o.grep is not None:
        flags = 0
        if o.case is False or (o.case is None and o.grep == o.grep.lower()):
            flags = re.IGNORECASE
        try:
            rx = re.compile(o.grep, flags)
        except re.error as ex:
            raise Fail('Failed to compile pattern "%s": %s' % (o.grep, ex))
    groups = [[]]
    for m in o.matches:
        if m == "+":
            groups.append([])
        else:
            groups[-1].append(m.split("=", 1))

    def match_groups(e):
        groups_ = [g for g in groups if g]
        if not groups_:
            return True
        for g in groups_:
            byfield = {}
            for f, v in g:
                byfield.setdefault(f, []).append(v)
            if all(e.get(f) in vs for f, vs in byfield.items()):
                return True
        return False
    sel = []
    for e in entries:
        if boot_id is not None and e.get("_BOOT_ID") != boot_id:
            continue
        if o.kernel and e.get("_TRANSPORT") != "kernel":
            continue
        if o.units and not unit_match(e, o.units):
            continue
        if o.idents and e.get("SYSLOG_IDENTIFIER") not in o.idents:
            continue
        if o.xidents and e.get("SYSLOG_IDENTIFIER") in o.xidents:
            continue
        if o.prio is not None:
            p = e.get("PRIORITY", "")
            if not p.isdigit() or not (pmin <= int(p) <= pmax):
                continue
        ts = entry_ts(e)
        if t_from is not None and ts < t_from:
            continue
        if t_to is not None and ts > t_to:
            continue
        if rx is not None and not rx.search(e.get("MESSAGE", "")):
            continue
        if not match_groups(e):
            continue
        sel.append(e)
    if o.field:
        seen = []
        for e in sel:
            v = e.get(o.field)
            if v is not None and v not in seen:
                seen.append(v)
        for v in seen:
            print(v)
        return 0
    if o.fields:
        names = sorted(set(k for e in entries for k in e))
        for n in names:
            print(n)
        return 0
    if isinstance(o.lines, tuple):
        sel = sel[:o.lines[1]]
    elif o.lines is not None:
        sel = sel[-o.lines:] if o.lines > 0 else []
    if o.reverse:
        sel = list(reversed(sel))
    if not sel:
        if not o.quiet and o.output not in ("json", "json-pretty", "cat"):
            print("-- No entries --")
        return 0
    out = []
    prev_boot = None
    for e in sel:
        if o.output.startswith("short"):
            if prev_boot is not None and e.get("_BOOT_ID") != prev_boot:
                out.append("-- Boot %s --" % e.get("_BOOT_ID"))
            prev_boot = e.get("_BOOT_ID")
            out.extend(format_entry(e, o.output, o.utc, o.host))
        elif o.output == "cat":
            out.append(e.get("MESSAGE", ""))
        elif o.output == "json":
            out.append(json.dumps(json_order(e), separators=(",", ":"), ensure_ascii=False))
        elif o.output == "json-pretty":
            out.append(json.dumps(json_order(e), indent="\t", ensure_ascii=False))
        elif o.output == "verbose":
            t = int(e["__REALTIME_TIMESTAMP"])
            d = localdt(t / 1e6, o.utc)
            out.append("%s.%06d %s [s=mock;b=%s]" % (d.strftime("%a %Y-%m-%d %H:%M:%S"), t % 1000000, tzabbr(d),
                                                  e.get("_BOOT_ID", "")))
            for k in sorted(e):
                if not k.startswith("__"):
                    out.append("    %s=%s" % (k, e[k]))
    try:
        sys.stdout.write("\n".join(out) + "\n")
        sys.stdout.flush()
    except BrokenPipeError:
        pass
    return 0


def json_order(e):
    keys = ["__CURSOR", "__REALTIME_TIMESTAMP", "__MONOTONIC_TIMESTAMP", "_BOOT_ID"]
    res = {}
    if "__CURSOR" not in e:
        res["__CURSOR"] = "s=mock;b=%s;t=%x" % (e.get("_BOOT_ID", ""), int(e["__REALTIME_TIMESTAMP"]))
    for k in keys:
        if k in e:
            res[k] = e[k]
    for k in e:
        if k not in res:
            res[k] = e[k]
    return res


def human_size(n):
    for unit in ("B", "K", "M", "G", "T"):
        if n < 1024 or unit == "T":
            return ("%d%s" % (n, unit)) if unit == "B" else ("%.1f%s" % (n, unit))
        n /= 1024.0


