    tab = table(([header] if o.legend else []) + body)
    if o.legend:
        lines.append(" " * prefixw + tab[0])
        tab = tab[1:]
    for r, line in zip(body, tab):
        mark = "\u25cf " if r[2] == "failed" or r[1] in ("not-found", "bad-setting") else "  "
        lines.append(("" if o.plain else mark) + line)
    if o.legend:
        lines.append("")
        lines.append("Legend: LOAD   \u2192 Reflects whether the unit definition was properly loaded.")
        lines.append("        ACTIVE \u2192 The high-level unit activation state, i.e. generalization of SUB.")
        lines.append("        SUB    \u2192 The low-level unit activation state, values depend on unit type.")
        lines.append("")
        if o.all:
            lines.append("%d loaded units listed." % len(rows))
        else:
            lines.append("%d loaded units listed. Pass --all to see loaded but inactive units, too." % len(rows))
        lines.append("To show all installed unit files use 'systemctl list-unit-files'.")
    print("\n".join(lines))
    return 0


_CLOSURE = []


def boot_closure():
    if _CLOSURE:
        return _CLOSURE[0]
    seen = set()
    queue = [get_default()]
    while queue:
        n = queue.pop()
        if n in seen:
            continue
        seen.add(n)
        u = get_unit(n)
        if u.type == "target":
            queue.extend(d for d in fwd_deps(u, ("Requires", "Wants", "BindsTo")) if unit_type(d) == "target")
    _CLOSURE.append(seen)
    return seen


