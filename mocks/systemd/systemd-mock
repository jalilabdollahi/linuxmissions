def cmd_enable(o, args, verb):
    names = need_units(args, verb)
    changes = []
    no_install = False
    for n in names:
        if verb == "reenable":
            do_disable(n, changes)
        if not do_enable(n, o.runtime, changes):
            no_install = True
    for c in changes:
        if not o.quiet:
            print(c)
    daemon_reload()
    if no_install and not changes:
        err(NO_INSTALL)
    rc = 0
    if o.now:
        rc = cmd_start(o, names, "start")
    return rc


def cmd_disable(o, args):
    names = need_units(args, "disable")
    changes = []
    for n in names:
        do_disable(n, changes)
    for c in changes:
        if not o.quiet:
            print(c)
    daemon_reload()
    if o.now:
        return cmd_stop(o, names)
    return 0


def cmd_mask(o, args):
    names = need_units(args, "mask")
    changes = []
    base = "/run/systemd/system" if o.runtime else "/etc/systemd/system"
    for n in names:
        link = rp("%s/%s" % (base, n))
        if os.path.islink(link) and os.readlink(link) == "/dev/null":
            continue
        if os.path.lexists(link) and not os.path.islink(link):
            raise Fail("Failed to mask unit: File %s/%s already exists." % (base, n))
        os.makedirs(os.path.dirname(link), exist_ok=True)
        if os.path.islink(link):
            os.unlink(link)
        os.symlink("/dev/null", link)
        changes.append("Created symlink %s/%s \u2192 /dev/null." % (base, n))
    for c in changes:
        if not o.quiet:
            print(c)
    daemon_reload()
    if o.now:
        return cmd_stop(o, names)
    return 0


def cmd_unmask(o, args):
    names = need_units(args, "unmask")
    for n in names:
        for base in ("/etc/systemd/system", "/run/systemd/system"):
            link = rp("%s/%s" % (base, n))
            if os.path.islink(link) and os.readlink(link) == "/dev/null":
                os.unlink(link)
                if not o.quiet:
                    print('Removed "%s/%s".' % (base, n))
    daemon_reload()
    return 0


def cmd_daemon_reload(o, args):
    daemon_reload()
    return 0


def dropin_lines(u):
    if not u.dropins:
        return []
    groups = []
    for p in u.dropins:
        d, f = p.rsplit("/", 1)
        if groups and groups[-1][0] == d:
            groups[-1][1].append(f)
        else:
            groups.append((d, [f]))
    lines = []
    for i, (d, files) in enumerate(groups):
        lines.append(("    Drop-In: " if i == 0 else "             ") + d)
        lines.append("             \u2514\u2500" + ", ".join(files))
    return lines


def process_lines(u, st):
    try:
        procs = json.loads(st.get("LMProcesses") or "[]")
    except ValueError:
        procs = []
    main = st.get("MainPID", "0")
    lines = []
    if not procs and st.get("ExecMainPID", "0") not in ("0", "") and st.get("ExecMainCode", "0") != "0":
        starts = u.execs("ExecStart")
        line = starts[0]["line"] if starts else ""
        procs = [{"pid": st["ExecMainPID"], "kind": "ExecStart", "cmd": line, "code": st["ExecMainCode"],
                  "status": st.get("ExecMainStatus", "0")}]
    for p in procs:
        if not p.get("code") or str(p.get("code")) == "0":
            continue
        if str(p["pid"]) == main and main != "0":
            continue
        lines.append("    Process: %s %s=%s (%s)" % (p["pid"], p["kind"], p["cmd"], fmt_exit(p["code"], p["status"])))
    return lines


def status_one(name, o, out):
    u = get_unit(name)
    st = eff_state(name)
    has_state = os.path.exists(state_file(name))
    if u.load_state == "not-found" and not has_state:
        err("Unit %s could not be found." % name)
        return 4
    active = st["ActiveState"]
    desc = u.description()
    head = "%s %s" % (glyph(active), name)
    if u.load_state in ("loaded", "bad-setting") and desc != name:
        head += " - " + desc
    out.append(head)
    if u.load_state == "loaded":
        es = enabled_state(name) or "disabled"
        if es in ("static", "masked", "alias", "indirect", "generated", "transient"):
            out.append("     Loaded: loaded (%s; %s)" % (u.fragment, es))
        else:
            out.append("     Loaded: loaded (%s; %s; preset: enabled)" % (u.fragment, es))
    elif u.load_state == "masked":
        out.append("     Loaded: masked (Reason: Unit %s is masked.)" % name)
    elif u.load_state == "not-found":
        out.append("     Loaded: not-found (Reason: Unit %s not found.)" % name)
    else:
        out.append("     Loaded: bad-setting (Reason: Unit %s has a bad unit file setting.)" % name)
    out.extend(dropin_lines(u))
    sub = st.get("SubState", "dead")
    since = st_time(st, "StateChangeTimestamp")
    if active == "failed":
        shown = "failed (Result: %s)" % st.get("Result", "exit-code")
    elif active == "activating" and sub == "auto-restart":
        shown = "activating (auto-restart) (Result: %s)" % st.get("Result", "exit-code")
    else:
        shown = "%s (%s)" % (active, sub)
    if since is not None:
        shown += " since %s; %s" % (fmt_ts(since), fmt_rel(since))
    out.append("     Active: " + shown)
    docs = []
    for d in u.values("Unit", "Documentation"):
        docs += d.split()
    for i, d in enumerate(docs):
        out.append(("       Docs: " if i == 0 else "             ") + d)
    out.extend(process_lines(u, st))
    main = st.get("MainPID", "0")
    if main not in ("0", "") and active in ("active", "reloading", "deactivating", "activating") \
            and sub != "auto-restart":
        out.append("   Main PID: %s (%s)" % (main, comm_of(main) if pid_alive(main) else "?"))
        procs = []
        try:
            pg = os.getpgid(int(main))
            procs = [(p, a) for p, g, a in proc_table() if g == pg]
        except (OSError, ValueError):
            procs = []
        if not procs and pid_alive(main):
            procs = [(int(main), comm_of(main))]
        if procs:
            out.append("      Tasks: %d (limit: 4558)" % len(procs))
            out.append("     CGroup: /system.slice/%s" % name)
            for i, (p, a) in enumerate(procs):
                tree = "\u2514\u2500" if i == len(procs) - 1 else "\u251c\u2500"
                out.append("             %s%d %s" % (tree, p, a))
    elif st.get("ExecMainPID", "0") not in ("0", "") and st.get("ExecMainCode", "0") != "0":
        out.append("   Main PID: %s (%s)" % (st["ExecMainPID"], fmt_exit(st["ExecMainCode"],
                                                                     st.get("ExecMainStatus", "0"))))
    if o.lines > 0:
        cur = current_boot_id()
        ents = [e for e in load_entries() if e.get("_BOOT_ID") == cur and unit_match(e, [name])]
        ents = ents[-o.lines:]
        if ents:
            out.append("")
            for e in ents:
                out.extend(format_entry(e, "short", False, True))
    return 3 if active != "active" else 0


def cmd_status(o, args):
    if not args:
        return status_overview()
    rc = 0
    blocks = []
    for n in [resolve_alias(mangle(a)) for a in args]:
        out = []
        r = status_one(n, o, out)
        if out:
            blocks.append("\n".join(out))
        if r == 4:
            rc = 4 if rc == 0 else rc
        elif r == 3 and rc == 0:
            rc = 3
        if out:
