def cmd_list_dependencies(o, args):
    name = resolve_alias(mangle(args[0])) if args else get_default()
    print(name)
    if o.reverse:
        kinds = ("Requires", "Requisite", "Wants", "BindsTo", "PartOf", "Upholds")
    seen = set([name])

    def children(n):
        if o.reverse:
            kids = reverse_deps(n, kinds)
        else:
            u = get_unit(n)
            kids = fwd_deps(u, ("Requires", "Requisite", "Wants", "BindsTo", "Upholds"))
            kids += [p for p in reverse_deps(n, ("PartOf",)) if p not in kids]
        return sorted(kids, key=lambda k: (unit_type(k) == "target", k))

    def walk(n, prefix):
        kids = children(n)
        for i, k in enumerate(kids):
            last = i == len(kids) - 1
            st = eff_state(k)["ActiveState"]
            print("%s %s%s%s" % (glyph(st), prefix, "\u2514\u2500" if last else "\u251c\u2500", k))
            if k in seen:
                continue
            if unit_type(k) == "target" or o.all:
                seen.add(k)
                walk(k, prefix + ("  " if last else "\u2502 "))
    walk(name, "")
    return 0


