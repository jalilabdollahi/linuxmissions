def cmd_mock_boot(o, args):
    """Mock-only: simulate a reboot. Stops every running service, then starts the
    default target (or the one given) with its dependency tree, printing console lines."""
    for n in all_unit_names():
        st = live_state(n)
        if st["ActiveState"] in ("active", "activating", "reloading", "deactivating"):
            stop_one(n)
    for n in state_names():
        with Lock():
            st = read_state(n)
            st.update(ActiveState="inactive", SubState="dead", Result="success", MainPID="0", LMSupervisorPID="",
                      LMStartTimes="", NRestarts="0", LMJob="")
            write_state(n, st)
    daemon_reload(log=False)
    target = resolve_alias(mangle(args[0], ".target")) if args else get_default()
    jlog("mock-boot: starting %s" % target, prio=6)
    results = start_transaction([target], console=True)
    time.sleep(0.3 * max(TIMESCALE, 0.1))
    failed = [n for n in all_unit_names() if live_state(n)["ActiveState"] == "failed"]
    for n in failed:
        if not any(r[0] == n and not r[1] for r in results):
            print("[FAILED] %s failed after it was started." % n)
    return 1 if failed or any(not ok for _n, ok, _r in results) else 0


