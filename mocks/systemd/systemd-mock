def sig_name(n):
    try:
        return signal.Signals(int(n)).name[3:]
    except (ValueError, TypeError):
        return str(n)


def sig_num(name):
    name = str(name).upper()
    if name.isdigit():
        return int(name)
    if not name.startswith("SIG"):
        name = "SIG" + name
    try:
        return int(getattr(signal, name))
    except AttributeError:
        return None


def fmt_exit(code, status):
    """('exited', 203) -> 'code=exited, status=203/EXEC'."""
    code = CODE_NAMES.get(str(code), str(code))
    try:
        status = int(status)
    except (TypeError, ValueError):
        status = 0
    if code == "exited":
        name = EXIT_NAMES.get(status)
        return "code=exited, status=%d%s" % (status, "/" + name if name else "")
    return "code=%s, signal=%s" % (code, sig_name(status))


# ------------------------------------------------------- enablement / links

def links_to(name):
    """Install symlinks for name: [(real link path, display path)] in etc/ and run/."""
    out = []
    for base in ("etc/systemd/system", "run/systemd/system"):
        real_base = rp(base)
        try:
            entries = os.listdir(real_base)
        except OSError:
            continue
        for e in entries:
            if e.endswith((".wants", ".requires", ".upholds")):
                p = os.path.join(real_base, e, name)
                if os.path.islink(p):
                    out.append((p, "/%s/%s/%s" % (base, e, name)))
    return out


def enabled_state(name):
    state, frag, _real = find_fragment(name)
    if state == "masked":
        return "masked"
    if state == "not-found":
        return None
    if state == "builtin":
        return "static"
    links = links_to(name)
    if any(l[1].startswith("/etc/") for l in links):
        return "enabled"
    if links:
        return "enabled-runtime"
    u = disk_unit(name)
    for a in u.deps("Alias", "Install"):
        if os.path.islink(rp("etc/systemd/system/" + a)):
            return "enabled"
    tmpl, inst = split_instance(name)
    if tmpl and inst == "":
        for real_dir, _ in unit_dirs():
            for sub in glob.glob(os.path.join(real_dir, "*.wants", name.split("@")[0] + "@*")):
                if os.path.islink(sub):
                    return "indirect"
    if not u.install_info():
        return "static"
    if not any(u.values("Install", k) for k in ("WantedBy", "RequiredBy", "UpheldBy", "Alias")):
        return "indirect"
    return "disabled"


def is_enabled_ok(s):
    return s in ("enabled", "enabled-runtime", "static", "alias", "indirect", "generated", "linked",
                 "linked-runtime", "transient")


NO_INSTALL = """The unit files have no installation config (WantedBy=, RequiredBy=, UpheldBy=,
Also=, or Alias= settings in the [Install] section, and DefaultInstance= for
template units). This means they are not meant to be enabled or disabled using systemctl.

Possible reasons for having these kinds of units are:
\u2022 A unit may be statically enabled by being symlinked from another unit's
  .wants/, .requires/, or .upholds/ directory.
\u2022 A unit's purpose may be to act as a helper for some other unit which has
  a requirement dependency on it.
\u2022 A unit may be started when needed via activation (socket, path, timer,
  D-Bus, udev, scripted systemctl call, ...).
\u2022 In case of template units, the unit is meant to be enabled with some
  instance name specified."""


def make_link(link_disp, target, changes):
    real = rp(link_disp)
    if os.path.islink(real) and os.readlink(real) == target:
        return
    os.makedirs(os.path.dirname(real), exist_ok=True)
    if os.path.islink(real):
        os.unlink(real)
    os.symlink(target, real)
    changes.append("Created symlink %s \u2192 %s." % (link_disp, target))


def do_enable(name, runtime, changes, seen=None):
    seen = seen if seen is not None else set()
    if name in seen:
        return True
    seen.add(name)
    state, frag, _real = find_fragment(name)
    if state == "not-found":
        raise Fail("Failed to enable unit: Unit file %s does not exist." % name)
    if state == "masked":
        raise Fail("Failed to enable unit: Unit file %s is masked." % frag)
    if state == "builtin":
        return False
    u = disk_unit(name)
    tmpl, inst = split_instance(name)
    if tmpl and inst == "":
        di = u.get("Install", "DefaultInstance")
        if not di:
            return False
        name = name.replace("@.", "@%s." % di)
    base = "/run/systemd/system" if runtime else "/etc/systemd/system"
    did = False
    for t in u.deps("WantedBy", "Install"):
        make_link("%s/%s.wants/%s" % (base, t, name), frag, changes)
        did = True
    for t in u.deps("RequiredBy", "Install"):
        make_link("%s/%s.requires/%s" % (base, t, name), frag, changes)
        did = True
    for t in u.deps("UpheldBy", "Install"):
        make_link("%s/%s.upholds/%s" % (base, t, name), frag, changes)
        did = True
    for a in u.deps("Alias", "Install"):
        make_link("%s/%s" % (base, a), frag, changes)
        did = True
    for a in u.deps("Also", "Install"):
        did = do_enable(a, runtime, changes, seen) or did
    return did


def do_disable(name, changes, seen=None):
    seen = seen if seen is not None else set()
    if name in seen:
        return
    seen.add(name)
    state, _frag, _real = find_fragment(name)
    if state == "not-found":
        raise Fail("Failed to disable unit: Unit file %s does not exist." % name)
    for real, d in links_to(name):
        os.unlink(real)
        changes.append('Removed "%s".' % d)
    if state == "ok":
        u = disk_unit(name)
        for a in u.deps("Alias", "Install"):
            for base in ("/etc/systemd/system", "/run/systemd/system"):
                p = rp("%s/%s" % (base, a))
                if os.path.islink(p) and os.readlink(p) != "/dev/null":
                    os.unlink(p)
                    changes.append('Removed "%s/%s".' % (base, a))
        for a in u.deps("Also", "Install"):
            do_disable(a, changes, seen)


def get_default():
    for base in ("etc/systemd/system", "run/systemd/system", "usr/local/lib/systemd/system",
                 "usr/lib/systemd/system", "lib/systemd/system"):
        p = rp(base + "/default.target")
        if os.path.islink(p):
            return os.path.basename(os.readlink(p))
        if os.path.isfile(p):
            return "default.target"
    return "graphical.target"


def resolve_alias(name):
    if name == "default.target":
        d = get_default()
        return d if d != "default.target" else name
    return name


# ------------------------------------------------------------- exec helpers

def parse_env_assignments(value):
    try:
        words = shlex.split(value, posix=True)
    except ValueError:
        return []
    out = []
    for w in words:
        if "=" in w and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", w):
            k, v = w.split("=", 1)
            out.append((k, v))
    return out


def parse_env_file(text):
    """systemd's environment file parser (KEY=VALUE, quotes, comments; CR ends a line)."""
    out = []
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    lines = text.split("\n")
    i = 0
    while i < len(lines):
        line = lines[i]
        i += 1
        while line.endswith("\\") and i < len(lines) and not line.lstrip().startswith(("#", ";")):
            line = line[:-1] + lines[i]
            i += 1
        s = line.strip()
        if not s or s[0] in "#;" or "=" not in s:
            continue
        k, v = s.split("=", 1)
        k = k.strip()
        if k.startswith("export "):
            k = k[7:].strip()
        if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", k):
            continue
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
            q = v[0]
            v = v[1:-1]
            if q == '"':
                v = re.sub(r'\\(["\\`$\n])', r"\1", v)
        else:
            v = re.sub(r"\\(.)", r"\1", v)
        out.append((k, v))
    return out


def expand_argv(argv, env):
    out = []
    for w in argv:
        m = re.match(r"^\$([A-Za-z_][A-Za-z0-9_]*)$", w)
        if m:
            out.extend(env.get(m.group(1), "").split())
            continue
        out.append(re.sub(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}", lambda mm: env.get(mm.group(1), ""), w))
    return out


def root_arg(a):
    """Rewrite '/fake/path' (or --opt=/fake/path) to the sandbox path when it exists there."""
    pre = ""
    val = a
    m = re.match(r"^(--?[A-Za-z0-9_-]+=)(/.*)$", a)
    if m:
        pre, val = m.group(1), m.group(2)
    if not val.startswith("/") or val.startswith(ROOT + "/"):
        return a
    real = rp(val)
    if os.path.lexists(real) or os.path.isdir(os.path.dirname(real)) and os.path.dirname(val) != "/":
        return pre + real
    return a


class ExecFail(Exception):
    def __init__(self, status, msgs, result="exit-code"):
        Exception.__init__(self, msgs[0] if msgs else str(status))
        self.status = status
        self.msgs = msgs
        self.result = result


def passwd_lookup(user):
    txt = read_text(rp("etc/passwd"))
    if txt is None:
        return {}
    for line in txt.splitlines():
        f = line.split(":")
        if len(f) >= 7 and (f[0] == user or f[2] == user):
            return {"name": f[0], "uid": f[2], "gid": f[3], "home": f[5], "shell": f[6]}
    return None


def service_env(u, mainpid=None):
    """Environment the service process gets. Raises ExecFail(resources)."""
    env = {"PATH": FIXED_PATH, "LANG": os.environ.get("LANG", "C.UTF-8"), "LM_ROOT": ROOT,
           "INVOCATION_ID": hashlib.md5(("%s%f" % (u.name, time.time())).encode()).hexdigest(),
           "SYSTEMD_EXEC_PID": str(os.getpid())}
    if os.environ.get("TZ"):
        env["TZ"] = os.environ["TZ"]
    user = u.svc("User")
    if user:
        pw = passwd_lookup(user)
        if pw:
            env.update({"USER": pw["name"], "LOGNAME": pw["name"], "HOME": pw["home"], "SHELL": pw["shell"]})
        else:
            env.update({"USER": user, "LOGNAME": user})
    for v in u.values("Service", "Environment"):
        for k, val in parse_env_assignments(v):
            env[k] = val
    for v in u.values("Service", "EnvironmentFile"):
        optional = v.startswith("-")
        path = v.lstrip("-").strip()
        real = root_resolve(path)
        txt = read_text(real) if os.path.isfile(real) else None
        if txt is None:
            if optional:
                continue
            raise ExecFail(0, ["Failed to load environment files: No such file or directory",
                               "Failed to run 'start' task: No such file or directory"], "resources")
        for k, val in parse_env_file(txt):
            env[k] = val
    if mainpid:
        env["MAINPID"] = str(mainpid)
    return env


def exec_prep(u, cmd, env):
    """-> (real executable, argv, cwd). Raises ExecFail for 200/203/217."""
    shown = cmd["path"]
    user = u.svc("User")
    if user and os.path.exists(rp("etc/passwd")) and passwd_lookup(user) is None:
        raise ExecFail(217, ["Failed to determine user credentials: No such process",
                             "Failed at step USER spawning %s: No such process" % shown])
    wd = u.svc("WorkingDirectory")
    cwd = ROOT
    if wd:
        optional = wd.startswith("-")
        w = wd.lstrip("-")
        if w == "~":
            pw = passwd_lookup(user) if user else None
            w = (pw or {}).get("home", "/root")
        real = root_resolve(w)
        if os.path.isdir(real):
            cwd = real
        elif not optional:
            raise ExecFail(200, ["Changing to the requested working directory failed: No such file or directory",
                                 "Failed at step CHDIR spawning %s: No such file or directory" % shown])
    real, _why = resolve_exec(cmd["path"])
    if real is None:
        raise ExecFail(203, ["Failed to locate executable %s: No such file or directory" % shown,
                             "Failed at step EXEC spawning %s: No such file or directory" % shown])
    if os.path.isdir(real) or not os.access(real, os.X_OK):
        raise ExecFail(203, ["Failed to execute %s: Permission denied" % shown,
                             "Failed at step EXEC spawning %s: Permission denied" % shown])
    argv = expand_argv(cmd["argv"], env)
    if not argv:
        argv = [cmd["path"]]
    args = [argv[0] if "@" in cmd["prefix"] else real] + [root_arg(a) for a in argv[1:]]
    return real, args, cwd


def _libc():
    try:
        import ctypes
        import ctypes.util
        return ctypes.CDLL(ctypes.util.find_library("c") or None, use_errno=True)
    except Exception:
        return None


LIBC = None


def exec_trampoline(args):
    """`--lm-exec ROOT UNIT REAL SHOWN ARGV0 ARGS...` or `--lm-exec ROOT UNIT --exit CODE`:
    new process group, die with the supervisor (Linux), default signals, then exec."""
    try:
        os.setpgid(0, 0)
    except OSError:
        pass
    libc = _libc()
    if libc is not None and sys.platform.startswith("linux"):
        try:
            libc.prctl(1, int(signal.SIGKILL), 0, 0, 0)   # PR_SET_PDEATHSIG
        except Exception:
            pass
    for s in ("SIGPIPE", "SIGXFSZ", "SIGINT", "SIGTERM", "SIGHUP", "SIGQUIT"):
        if hasattr(signal, s):
            signal.signal(getattr(signal, s), signal.SIG_DFL)
    unit = args[1]
    if args[2] == "--exit":
        os._exit(int(args[3]))
    real, shown, argv = args[2], args[3], args[4:]
    try:
        sys.stdout.flush()
        os.execv(real, argv)
    except OSError as e:
        reason = os.strerror(e.errno) if e.errno else str(e)
        jlog("%s: Failed to execute %s: %s" % (unit, shown, reason), unit=unit, prio=3)
        jlog("%s: Failed at step EXEC spawning %s: %s" % (unit, shown, reason), unit=unit, prio=3)
        os._exit(203)


# ----------------------------------------------------------------- supervisor

class Supervisor(object):
    """Runs one service: ExecStartPre/ExecStart/ExecStartPost, Restart= policy,
    stop requests (SIGTERM from systemctl), journal output."""

    def __init__(self, name):
        self.name = name
        self.u = get_unit(name)
        self.stop_req = False
        self.main_pid = 0
        self.main_own = True
        self.pgid = 0
        self.reaped = {}
        self.threads = []
        self.desc = self.u.description()
        self.processes = []

    def log(self, msg, prio=6):
        jlog(msg, unit=self.name, prio=prio)

    def on_term(self, *_a):
        self.stop_req = True

    def reap(self):
        while True:
            try:
                pid, status = os.waitpid(-1, os.WNOHANG)
            except ChildProcessError:
                return
            except InterruptedError:
                continue
            if pid == 0:
                return
            self.reaped[pid] = status

    def wait_for(self, pid, timeout=None, interruptible=True, own=True):
        """-> raw wait status, or None (stop requested / timeout)."""
        start = time.time()
        while True:
            self.reap()
            if pid in self.reaped:
                return self.reaped.pop(pid)
            if not own and not pid_alive(pid):
                return 0
            if interruptible and self.stop_req:
                return None
            if timeout is not None and time.time() - start > timeout:
                return None
            time.sleep(0.02)

    @staticmethod
    def decode(status):
        if os.WIFEXITED(status):
            return "exited", os.WEXITSTATUS(status)
        sig = os.WTERMSIG(status)
        return ("dumped" if os.WCOREDUMP(status) else "killed"), sig

    def output_targets(self):
        so = self.u.svc("StandardOutput", "journal")
        se = self.u.svc("StandardError", "inherit")

        def opn(spec):
            for pfx, mode in (("file:", "r+"), ("append:", "a"), ("truncate:", "w")):
                if spec.startswith(pfx):
                    real = root_resolve(spec[len(pfx):])
                    if mode == "r+" and not os.path.exists(real):
                        mode = "w"
                    try:
                        fh = open(real, mode)
                        return fh
                    except OSError:
                        return subprocess.DEVNULL
            if spec == "null":
                return subprocess.DEVNULL
            return subprocess.PIPE
        out = opn(so)
        errt = subprocess.STDOUT if se == "inherit" or se == so else opn(se)
        return out, errt

    def pump(self, stream, pid, ident):
        prefix_ok = self.u.bool("Service", "SyslogLevelPrefix", True)
        for raw in iter(stream.readline, b""):
            line = raw.decode("utf-8", "replace").rstrip("\n")
            prio = 6
            m = re.match(r"^<([0-7])>(.*)$", line)
            if m and prefix_ok:
                prio, line = int(m.group(1)), m.group(2)
            jlog(line, ident=ident, pid=pid, prio=prio, sunit=self.name, transport="stdout",
                 extra={"_COMM": ident[:15]})
        try:
            stream.close()
        except OSError:
            pass

    def spawn(self, cmd, env, kind):
        """Start one command; -> pid. A failing exec becomes a short-lived process
        exiting with systemd's code (203/EXEC, 200/CHDIR, 217/USER), like the real fork."""
        self.spawn_failed = False
        self.spawn_msgs = []
        try:
            real, args, cwd = exec_prep(self.u, cmd, env)
        except ExecFail as e:
            if kind == "ExecStart":
                self.spawn_msgs = list(e.msgs)
            else:
                for m in e.msgs:
                    self.log("%s: %s" % (self.name, m), prio=3)
            self.spawn_failed = True
            return self.fake_exit(e.status)
        out, errt = self.output_targets()
        ident = self.u.svc("SyslogIdentifier") or os.path.basename(cmd["argv"][0] if cmd["argv"] else cmd["path"])
        tramp = [sys.executable, self_path(), "--lm-exec", ROOT, self.name, real, cmd["path"]] + args
        p = subprocess.Popen(tramp, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=out, stderr=errt,
                             close_fds=True)
        p.returncode = 0   # reaped by waitpid(-1); keep Popen from complaining
        if out is subprocess.PIPE:
            t = threading.Thread(target=self.pump, args=(p.stdout, p.pid, ident))
            t.daemon = True
            t.start()
            self.threads.append(t)
        return p.pid

    def fake_exit(self, code):
        p = subprocess.Popen([sys.executable, self_path(), "--lm-exec", ROOT, self.name, "--exit", str(code)],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        p.returncode = 0
        return p.pid

    def record(self, pid, kind, cmd, code="", status=""):
        for pr in self.processes:
            if pr["pid"] == pid:
                pr["code"], pr["status"] = code, status
                break
        else:
            self.processes.append({"pid": pid, "kind": kind, "cmd": cmd["line"], "code": code, "status": status})
        update_state(self.name, LMProcesses=json.dumps(self.processes))

    def flush_spawn_msgs(self):
        for m in getattr(self, "spawn_msgs", []):
            self.log("%s: %s" % (self.name, m), prio=3)
        self.spawn_msgs = []

    def run_cmd(self, cmd, env, kind, timeout=None):
        """Run a control command to completion -> (ok, code, status)."""
        pid = self.spawn(cmd, env, kind)
        self.record(pid, kind, cmd)
        st = self.wait_for(pid, timeout=timeout, interruptible=False)
        if st is None:
            try:
                os.killpg(pid, signal.SIGKILL)
            except OSError:
                pass
            st = self.wait_for(pid, interruptible=False)
        code, status = self.decode(st)
        self.record(pid, kind, cmd, code, status)
        ok = (code == "exited" and status == 0) or cmd["ignore"]
        if not (code == "exited" and status == 0):
            self.log("%s: Control process exited, %s" % (self.name, fmt_exit(code, status)),
                     prio=6 if cmd["ignore"] else 5)
        return ok, code, status

    def clean_exit(self, code, status):
        success = set()
        for v in self.u.values("Service", "SuccessExitStatus"):
            for w in v.split():
                success.add(w)
        if code == "exited":
            return status == 0 or str(status) in success
        if code == "killed":
            return status in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM, signal.SIGPIPE) \
                or sig_name(status) in success or ("SIG" + sig_name(status)) in success
        return False

    def should_restart(self, code, status, result):
        policy = self.u.restart()
        prevent = set()
        for v in self.u.values("Service", "RestartPreventExitStatus"):
            prevent.update(v.split())
        if code == "exited" and str(status) in prevent:
            return False
        if code in ("killed", "dumped") and (sig_name(status) in prevent or "SIG" + sig_name(status) in prevent):
            return False
        clean = result == "success"
        if policy == "always":
            return True
        if policy == "on-success":
            return clean
        if policy == "on-failure":
            return not clean
        if policy == "on-abnormal":
            return result in ("signal", "core-dump", "timeout", "watchdog")
        if policy == "on-abort":
            return result in ("signal", "core-dump")
        return False

    def kill_group(self, sig):
        mode = self.u.svc("KillMode", "control-group")
        targets = []
        if self.main_pid:
            targets.append(("pid", self.main_pid))
        if mode in ("control-group", "mixed") and self.pgid:
            targets.append(("pg", self.pgid))
        for kind, pid in targets:
            if mode == "none":
                continue
            try:
                if kind == "pg":
                    os.killpg(pid, sig if mode == "control-group" else signal.SIGKILL)
                else:
                    os.kill(pid, sig)
            except OSError:
                pass

    def kill_leftovers(self):
        if self.u.svc("KillMode", "control-group") not in ("control-group", "mixed") or not self.pgid:
            return
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.killpg(self.pgid, sig)
            except OSError:
                return
            time.sleep(0.05)
            self.reap()

    def finish_job(self, result):
        update_state(self.name, LMJob="", LMJobResult=result)

    def main(self):
        global LIBC
        LIBC = _libc()
        signal.signal(signal.SIGTERM, self.on_term)
        signal.signal(signal.SIGINT, self.on_term)
        signal.signal(signal.SIGHUP, signal.SIG_IGN)
        if LIBC is not None and sys.platform.startswith("linux"):
            try:
                LIBC.prctl(36, 1, 0, 0, 0)  # PR_SET_CHILD_SUBREAPER
            except Exception:
                pass
        update_state(self.name, LMSupervisorPID=os.getpid())
        try:
            self.loop()
        finally:
            with Lock():
                st = read_state(self.name)
                if st.get("LMSupervisorPID") == str(os.getpid()):
                    st["LMSupervisorPID"] = ""
                    st["LMJob"] = ""
                    if st["ActiveState"] in ("activating", "deactivating", "reloading") or \
                            (st["ActiveState"] == "active" and st["SubState"] == "running"):
                        st.update(ActiveState="failed", SubState="failed", Result="protocol", MainPID="0")
                    write_state(self.name, st)

    def loop(self):
        first = True
        nrestarts = 0
        while True:
            if not first:
                interval, burst = self.u.start_limit()
                with Lock():
                    st = read_state(self.name)
                    times = prune_starts(st, interval)
                    if burst > 0 and interval > 0 and len(times) >= burst:
                        st.update(ActiveState="failed", SubState="failed", Result="start-limit-hit", MainPID="0",
                                  LMSupervisorPID="", StateChangeTimestamp=stamp(), InactiveEnterTimestamp=stamp())
                        write_state(self.name, st)
                        self.log("%s: Start request repeated too quickly." % self.name, prio=4)
                        self.log("%s: Failed with result 'start-limit-hit'." % self.name, prio=4)
                        self.log("Failed to start %s - %s." % (self.name, self.desc), prio=3)
                        return
                    times.append(time.time())
                    st["LMStartTimes"] = ",".join("%.3f" % t for t in times)
                    write_state(self.name, st)
            outcome = self.run_once(first)
            first = False
            if outcome is None:
                return
            code, status, result = outcome
            if self.stop_req:
                self.stopped(result)
                return
            if result != "skip" and self.should_restart(code, status, result):
                update_state(self.name, ActiveState="activating", SubState="auto-restart", Result=result,
                             MainPID="0", StateChangeTimestamp=stamp())
                delay = self.u.timespan("RestartSec", 0.1) * TIMESCALE
                end = time.time() + delay
                while time.time() < end and not self.stop_req:
                    time.sleep(min(0.05, max(0.0, end - time.time())))
                if self.stop_req:
                    update_state(self.name, ActiveState="inactive", SubState="dead", LMSupervisorPID="",
                                 StateChangeTimestamp=stamp(), InactiveEnterTimestamp=stamp())
                    return
                nrestarts += 1
                update_state(self.name, NRestarts=nrestarts)
                self.log("%s: Scheduled restart job, restart counter is at %d." % (self.name, nrestarts))
                self.log("Stopped %s - %s." % (self.name, self.desc))
                continue
            return

    def run_once(self, first):
        """One activation. -> (code, status, result) after the service went down, or None when done."""
        u = self.u
        stype = u.stype()
        self.processes = []
        self.main_pid = 0
        self.pgid = 0
        update_state(self.name, ActiveState="activating", SubState="start-pre", MainPID="0", Result="success",
                     LMProcesses="[]", StateChangeTimestamp=stamp())
        self.log("Starting %s - %s..." % (self.name, self.desc))
        try:
            env = service_env(u)
        except ExecFail as e:
            for m in e.msgs:
                self.log("%s: %s" % (self.name, m), prio=3)
            return self.failed("resources", None, None, starting=True)
        update_state(self.name, LMEnvironment=json.dumps(sorted("%s=%s" % kv for kv in env.items())))
        for cmd in u.execs("ExecStartPre"):
            ok, code, status = self.run_cmd(cmd, env, "ExecStartPre", timeout=u.timespan("TimeoutStartSec", 90))
            if self.stop_req:
                return self.failed("success", None, None, starting=True, quiet=True)
            if not ok:
                res = "exit-code" if code == "exited" else ("core-dump" if code == "dumped" else "signal")
                return self.failed(res, code, status, starting=True)
        starts = u.execs("ExecStart")
        if not starts:
            self.set_up(stype, remain=True)
            return None
        main_result = None
        for i, cmd in enumerate(starts):
            update_state(self.name, SubState="start")
            pid = self.spawn(cmd, env, "ExecStart")
            self.record(pid, "ExecStart", cmd)
            self.main_pid = pid
            self.main_own = True
            self.pgid = pid
            update_state(self.name, MainPID=pid, ExecMainPID=pid, ExecMainStartTimestamp=stamp(),
                         ExecMainCode="0", ExecMainStatus="0")
            if stype in ("oneshot", "forking"):
                self.flush_spawn_msgs()
                st = self.wait_for(pid, timeout=u.timespan("TimeoutStartSec", 90) * TIMESCALE
                                   if stype == "forking" else None)
                if st is None:
                    if self.stop_req:
                        self.do_stop_sequence(env)
                        return None
                    self.kill_group(signal.SIGKILL)
                    self.wait_for(pid, interruptible=False)
                    return self.failed("timeout", None, None, starting=True)
                code, status = self.decode(st)
                self.record(pid, "ExecStart", cmd, code, status)
                update_state(self.name, ExecMainCode=CODE_NUMS[code], ExecMainStatus=status,
                             ExecMainExitTimestamp=stamp(), MainPID="0")
                if not (code == "exited" and status == 0) and not cmd["ignore"] \
                        and not self.clean_exit(code, status):
                    self.log("%s: Main process exited, %s" % (self.name, fmt_exit(code, status)),
                             prio=5)
                    res = "exit-code" if code == "exited" else ("core-dump" if code == "dumped" else "signal")
                    self.kill_leftovers()
                    return self.failed(res, code, status, starting=True)
                if stype == "forking":
                    main_result = self.forked_main()
                    break
                continue
            break
        if stype == "oneshot":
            self.main_pid = 0
            self.kill_leftovers()
            for cmd in u.execs("ExecStartPost"):
                self.run_cmd(cmd, env, "ExecStartPost")
            if u.bool("Service", "RemainAfterExit"):
                self.set_up(stype, remain=True)
                return None
            self.log("%s: Deactivated successfully." % self.name)
            self.log("Finished %s - %s." % (self.name, self.desc))
            update_state(self.name, ActiveState="inactive", SubState="dead", Result="success", LMSupervisorPID="",
                         StateChangeTimestamp=stamp(), InactiveEnterTimestamp=stamp())
            self.finish_job("done")
            self.run_stop_post(env)
            return None
        if stype == "forking" and main_result is None:
            return self.failed("protocol", None, None, starting=True)
        if stype == "exec" and self.spawn_failed:
            self.flush_spawn_msgs()
            st = self.wait_for(self.main_pid, interruptible=False)
            code, status = self.decode(st)
            self.record(self.main_pid, "ExecStart", starts[0], code, status)
            update_state(self.name, ExecMainCode=CODE_NUMS[code], ExecMainStatus=status,
                         ExecMainExitTimestamp=stamp(), MainPID="0")
            self.log("%s: Main process exited, %s" % (self.name, fmt_exit(code, status)), prio=5)
            return self.failed("exit-code", code, status, starting=True)
        self.set_up(stype)
        self.flush_spawn_msgs()
        env_main = dict(env)
        env_main["MAINPID"] = str(self.main_pid)
        for cmd in u.execs("ExecStartPost"):
            self.run_cmd(cmd, env_main, "ExecStartPost")
        st = self.wait_for(self.main_pid, own=self.main_own)
        if st is None:
            self.do_stop_sequence(env_main)
            return None
        code, status = self.decode(st)
        self.record(self.main_pid, "ExecStart", starts[0], code, status)
        update_state(self.name, ExecMainCode=CODE_NUMS[code], ExecMainStatus=status, ExecMainExitTimestamp=stamp(),
                     MainPID="0")
        self.kill_leftovers()
        if self.clean_exit(code, status):
            result = "success"
        else:
            result = "exit-code" if code == "exited" else ("core-dump" if code == "dumped" else "signal")
            self.log("%s: Main process exited, %s" % (self.name, fmt_exit(code, status)), prio=5)
        for cmd in u.execs("ExecStopPost"):
            self.run_cmd(cmd, env_main, "ExecStopPost")
        if result == "success":
            if u.bool("Service", "RemainAfterExit"):
                update_state(self.name, ActiveState="active", SubState="exited")
                return None
            self.log("%s: Deactivated successfully." % self.name)
            restart = self.should_restart(code, status, result)
            update_state(self.name, ActiveState="inactive", SubState="dead", Result="success",
                         LMSupervisorPID="" if not restart else os.getpid(), StateChangeTimestamp=stamp(),
                         InactiveEnterTimestamp=stamp(), ActiveExitTimestamp=stamp())
            return code, status, result
        self.log("%s: Failed with result '%s'." % (self.name, result), prio=4)
        restart = self.should_restart(code, status, result)
        update_state(self.name, ActiveState="failed" if not restart else "activating",
                     SubState="failed" if not restart else "auto-restart", Result=result,
                     LMSupervisorPID="" if not restart else os.getpid(),
                     StateChangeTimestamp=stamp(), InactiveEnterTimestamp=stamp(), ActiveExitTimestamp=stamp())
        return code, status, result

    def _is_child(self, pid):
        txt = read_text("/proc/%d/stat" % pid)
        if txt:
            try:
                return int(txt.rsplit(")", 1)[1].split()[1]) == os.getpid()
            except (IndexError, ValueError):
                return False
        return False

    def forked_main(self):
        pidfile = self.u.svc("PIDFile")
        if pidfile:
            for _ in range(50):
                txt = read_text(root_resolve(pidfile))
                if txt and txt.strip().isdigit() and pid_alive(int(txt.strip())):
                    self.main_pid = int(txt.strip())
                    self.main_own = self._is_child(self.main_pid)
                    break
                time.sleep(0.02)
            else:
                self.log("%s: Can't open PID file %s (yet?) after start: No such file or directory"
                         % (self.name, pidfile), prio=4)
                return None
        else:
            left = sorted(p for p, pg, _a in proc_table() if pg == self.pgid and pid_alive(p))
            if not left:
                return None
            self.main_pid = left[0]
        self.main_own = self._is_child(self.main_pid)
        try:
            self.pgid = os.getpgid(self.main_pid)
        except OSError:
            pass
        update_state(self.name, MainPID=self.main_pid, ExecMainPID=self.main_pid)
        return self.main_pid

    def set_up(self, stype, remain=False):
        sub = "exited" if remain else "running"
        update_state(self.name, ActiveState="active", SubState=sub, Result="success",
                     StateChangeTimestamp=stamp(), ActiveEnterTimestamp=stamp())
        self.log("%s %s - %s." % ("Finished" if stype == "oneshot" else "Started", self.name, self.desc))
        self.finish_job("done")

    def failed(self, result, code, status, starting=False, quiet=False):
        if not quiet:
            self.log("%s: Failed with result '%s'." % (self.name, result), prio=4)
            if starting:
                self.log("Failed to start %s - %s." % (self.name, self.desc), prio=3)
        restart = result not in ("resources", "protocol", "success") and \
            self.should_restart(code, status, result)
        if result == "success":
            update_state(self.name, ActiveState="inactive", SubState="dead", LMSupervisorPID="",
                         StateChangeTimestamp=stamp(), InactiveEnterTimestamp=stamp())
        else:
            update_state(self.name, ActiveState="activating" if restart else "failed",
                         SubState="auto-restart" if restart else "failed", Result=result, MainPID="0",
                         LMSupervisorPID=os.getpid() if restart else "",
                         StateChangeTimestamp=stamp(), InactiveEnterTimestamp=stamp())
        self.finish_job("failed:" + result if result != "success" else "done")
        if code is None:
            return (None, None, "skip") if not restart else ("exited", 1, result)
        return code, status, result

    def run_stop_post(self, env):
        for cmd in self.u.execs("ExecStopPost"):
            self.run_cmd(cmd, env, "ExecStopPost")

    def do_stop_sequence(self, env):
        u = self.u
        self.stop_req = True
        update_state(self.name, ActiveState="deactivating", SubState="stop", StateChangeTimestamp=stamp())
        self.log("Stopping %s - %s..." % (self.name, self.desc))
        alive = self.main_pid and (self.main_pid not in self.reaped) and pid_alive(self.main_pid)
        env2 = dict(env)
        env2["MAINPID"] = str(self.main_pid or "")
        for cmd in u.execs("ExecStop"):
            self.run_cmd(cmd, env2, "ExecStop", timeout=u.timespan("TimeoutStopSec", 90) * TIMESCALE)
        result = "success"
        if alive:
            update_state(self.name, SubState="stop-sigterm")
            sig = sig_num(u.svc("KillSignal", "SIGTERM")) or signal.SIGTERM
            self.kill_group(sig)
            own = self.main_own
            st = self.wait_for(self.main_pid, timeout=u.timespan("TimeoutStopSec", 90) * TIMESCALE,
                               interruptible=False, own=own)
            if st is None:
                self.log("%s: State 'stop-sigterm' timed out. Killing." % self.name, prio=4)
                self.log("%s: Killing process %d (%s) with signal SIGKILL." % (self.name, self.main_pid,
                                                                                comm_of(self.main_pid)), prio=4)
                self.kill_group(signal.SIGKILL)
                st = self.wait_for(self.main_pid, timeout=5, interruptible=False, own=own)
                result = "timeout"
            if st is not None:
                code, status = self.decode(st)
                update_state(self.name, ExecMainCode=CODE_NUMS[code], ExecMainStatus=status,
                             ExecMainExitTimestamp=stamp())
                for pr in self.processes:
                    if pr["pid"] == self.main_pid:
                        pr["code"], pr["status"] = code, status
                update_state(self.name, LMProcesses=json.dumps(self.processes))
        self.kill_leftovers()
        self.run_stop_post(env2)
        self.stopped(result)

    def stopped(self, result="success"):
        if result == "success":
            self.log("%s: Deactivated successfully." % self.name)
            update_state(self.name, ActiveState="inactive", SubState="dead", Result="success", MainPID="0",
                         LMSupervisorPID="", LMJob="", StateChangeTimestamp=stamp(),
                         InactiveEnterTimestamp=stamp(), ActiveExitTimestamp=stamp())
        else:
            self.log("%s: Failed with result '%s'." % (self.name, result), prio=4)
            update_state(self.name, ActiveState="failed", SubState="failed", Result=result, MainPID="0",
                         LMSupervisorPID="", LMJob="", StateChangeTimestamp=stamp(),
                         InactiveEnterTimestamp=stamp())
        self.log("Stopped %s - %s." % (self.name, self.desc))


def prune_starts(st, interval):
    times = []
    for t in st.get("LMStartTimes", "").split(","):
        try:
            times.append(float(t))
        except ValueError:
            pass
    return [t for t in times if t > time.time() - interval * TIMESCALE]


# ------------------------------------------------------------ job execution

def self_path():
    return os.path.abspath(sys.argv[0])


def job_failed_msg(name, result):
    tail = '\nSee "systemctl status %s" and "journalctl -xeu %s" for details.' % (name, name)
    if result == "start-limit-hit":
        return ("Job for %s failed because start of the service was attempted too often.%s\n"
                'To force a start use "systemctl reset-failed %s"\nfollowed by "systemctl start %s" again.'
                % (name, tail, name, name))
    if result == "dependency":
        return "A dependency job for %s failed. See 'journalctl -xe' for details." % name
    reasons = {"exit-code": "the control process exited with error code",
               "signal": "a fatal signal was delivered to the control process",
               "core-dump": "a fatal signal was delivered causing the control process to dump core",
               "timeout": "a timeout was exceeded",
               "resources": "of unavailable resources or another system error",
               "protocol": "the service did not take the steps required by its unit configuration"}
    if result in reasons:
        return "Job for %s failed because %s.%s" % (name, reasons[result], tail)
    return "Job for %s failed.%s" % (name, tail)


def start_one(name, wait=True):
    """Start one unit (no dependencies). -> (ok, result)."""
    u = get_unit(name)
    if u.type != "service":
        st = live_state(name)
        if st["ActiveState"] != "active":
            update_state(name, ActiveState="active", SubState="active" if u.type == "target" else "running",
                         Result="success", StateChangeTimestamp=stamp(), ActiveEnterTimestamp=stamp())
            if u.type == "target":
                jlog("Reached target %s - %s." % (name, u.description()), unit=name)
        return True, "done"
    with Lock():
        st = read_state(name)
        sup = st.get("LMSupervisorPID", "")
        if st["ActiveState"] in ("active", "reloading") or (st["ActiveState"] in ("activating", "deactivating")
                                                            and sup and pid_alive(sup)):
            return True, "done"
        interval, burst = u.start_limit()
        times = prune_starts(st, interval)
        if burst > 0 and interval > 0 and len(times) >= burst:
            st.update(ActiveState="failed", SubState="failed", Result="start-limit-hit",
                      StateChangeTimestamp=stamp())
            write_state(name, st)
            jlog("%s: Start request repeated too quickly." % name, unit=name, prio=4)
            jlog("%s: Failed with result 'start-limit-hit'." % name, unit=name, prio=4)
            jlog("Failed to start %s - %s." % (name, u.description()), unit=name, prio=3)
            return False, "start-limit-hit"
        times.append(time.time())
        st.update(ActiveState="activating", SubState="start", Result="success", LMJob="start", LMJobResult="",
                  NRestarts="0", MainPID="0", LMProcesses="[]", StateChangeTimestamp=stamp(),
                  InactiveExitTimestamp=stamp(), LMStartTimes=",".join("%.3f" % t for t in times))
        write_state(name, st)
    env = dict(os.environ)
    env["LM_ROOT"] = ROOT
    p = subprocess.Popen([sys.executable, self_path(), "--lm-supervise", name, "--lm-root", ROOT],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         close_fds=True, start_new_session=True, env=env)
    update_state(name, LMSupervisorPID=p.pid)
    if not wait:
        return True, "done"
    limit = time.time() + max(5.0, u.timespan("TimeoutStartSec", 90) * TIMESCALE + 5)
    while time.time() < limit:
        st = read_state(name)
        if not st.get("LMJob"):
            break
        if p.poll() is not None:
            st = read_state(name)
            break
        time.sleep(0.02)
    res = st.get("LMJobResult", "") or "done"
    if res.startswith("failed:"):
        return False, res.split(":", 1)[1]
    return True, "done"


def stop_one(name):
    u = get_unit(name)
    st = live_state(name)
    if u.type != "service":
        if st["ActiveState"] != "inactive":
            update_state(name, ActiveState="inactive", SubState="dead", StateChangeTimestamp=stamp())
            if u.type == "target":
                jlog("Stopped target %s - %s." % (name, u.description()), unit=name)
        return
    sup = st.get("LMSupervisorPID", "")
    if sup and pid_alive(sup):
        try:
            os.kill(int(sup), signal.SIGTERM)
        except OSError:
            pass
        limit = time.time() + u.timespan("TimeoutStopSec", 90) * TIMESCALE + 10
        while time.time() < limit and pid_alive(sup):
            time.sleep(0.02)
        return
    main = st.get("MainPID", "0")
    if st["ActiveState"] in ("active", "activating", "deactivating", "reloading"):
        jlog("Stopping %s - %s..." % (name, u.description()), unit=name)
        run_control_cmds(name, u, "ExecStop", main)
        if pid_alive(main):
            try:
                os.kill(int(main), signal.SIGTERM)
            except OSError:
                pass
        run_control_cmds(name, u, "ExecStopPost", main)
        jlog("%s: Deactivated successfully." % name, unit=name)
        jlog("Stopped %s - %s." % (name, u.description()), unit=name)
        update_state(name, ActiveState="inactive", SubState="dead", Result="success", MainPID="0",
                     LMSupervisorPID="", StateChangeTimestamp=stamp(), InactiveEnterTimestamp=stamp())


def is_activeish(name):
    return live_state(name)["ActiveState"] in ("active", "activating", "reloading", "deactivating")


def fwd_deps(u, kinds=("Requires", "Requisite", "Wants", "BindsTo", "Upholds")):
    out = []
    for k in kinds:
        for d in u.deps(k):
            if d not in out:
                out.append(d)
    for kind, key in (("wants", "Wants"), ("requires", "Requires"), ("upholds", "Upholds")):
        if key in kinds:
            for d in wants_dir(u.name, kind):
                if d not in out:
                    out.append(d)
    return out


def reverse_deps(name, kinds):
    """Units that have name in one of kinds (Requires/BindsTo/PartOf/Wants...)."""
    out = []
    for n in all_unit_names():
        if n == name:
            continue
        u = get_unit(n)
        if u.load_state not in ("loaded", "bad-setting"):
            continue
        if name in fwd_deps(u, tuple(k for k in kinds if k != "PartOf")) or \
                ("PartOf" in kinds and name in u.deps("PartOf")):
            out.append(n)
    return out


def ordered(names, units):
    """Topological order by After=/Before=; ties alphabetical. -> (order, cycle messages, dropped)."""
    names = list(dict.fromkeys(names))
    nset = set(names)
    after = dict((n, set()) for n in names)
    for n in names:
        u = units[n]
        for a in u.deps("After"):
            if a in nset and a != n:
                after[n].add(a)
        for b in u.deps("Before"):
            if b in nset and b != n:
                after[b].add(n)
        if not default_deps(u):
            continue
        if u.type == "target":
            # systemd.target(5): Wants=/Requires= are complemented with After=
            for d in fwd_deps(u, ("Requires", "Wants", "BindsTo")):
                if d in nset and d != n and default_deps(units[d]) and n not in units[d].deps("After"):
                    after[n].add(d)
        elif u.type == "service":
            for d in ("sysinit.target", "basic.target"):
                if d in nset and n not in units[d].deps("After") and n not in fwd_deps(units[d]):
                    after[n].add(d)
    msgs = []
    dropped = []
    order = []
    remaining = set(names)
    while remaining:
        ready = sorted(n for n in remaining if not (after[n] & remaining))
        if ready:
            n = ready[0]
            order.append(n)
            remaining.discard(n)
            continue
        cycle = find_cycle(remaining, after)
        start = cycle[0]
        for c in cycle[1:]:
            msgs.append("%s: Found ordering cycle on %s/start" % (start, c))
        msgs.append("%s: Found dependency on %s/start" % (start, start))
        victim = None
        for c in reversed(cycle):
            if units[c].type != "target":
                victim = c
                break
        victim = victim or cycle[-1]
        msgs.append("%s: Job %s/start deleted to break ordering cycle starting with %s/start"
                    % (start, victim, start))
        remaining.discard(victim)
        dropped.append(victim)
    return order, msgs, dropped


def default_deps(u):
    if u.name in NO_DEFAULT_DEPS:
        return False
    return u.get("Unit", "DefaultDependencies", "yes").lower() not in ("no", "false", "0", "off")


NO_DEFAULT_DEPS = set(["sysinit.target", "local-fs.target", "swap.target", "sockets.target", "timers.target",
                       "paths.target", "slices.target", "basic.target", "network-pre.target", "emergency.target",
                       "shutdown.target", "reboot.target", "rescue.target"])


def find_cycle(nodes, after):
    for start in sorted(nodes):
        path = [start]
        seen = {start: 0}
        cur = start
        while True:
            nxt = sorted(a for a in after[cur] if a in nodes)
            if not nxt:
                break
            cur = nxt[0]
            if cur in seen:
                return path[seen[cur]:]
            seen[cur] = len(path)
            path.append(cur)
    return sorted(nodes)[:1]


def start_transaction(requested, console=False):
    """Start requested units and what they pull in. -> list of (unit, ok, result)."""
    units = {}
    pulled = []
    required = {}
    queue = [resolve_alias(n) for n in requested]
    while queue:
        n = queue.pop(0)
        if n in units:
            continue
        u = get_unit(n)
        units[n] = u
        pulled.append(n)
        if u.load_state != "loaded":
            continue
        for d in fwd_deps(u, ("Requires", "BindsTo")):
            required.setdefault(d, set()).add(n)
            queue.append(d)
        for d in fwd_deps(u, ("Wants", "Upholds")):
            dd = get_unit(d)
            if dd.load_state in ("loaded",):
                queue.append(d)
    order, msgs, dropped = ordered(pulled, units)
    for m in msgs:
        start = m.split(":", 1)[0]
        jlog(m, unit=start, prio=4 if "deleted" in m else 3)
        if console:
            print(m)
    results = []
    failed = set()
    for n in order:
        u = units[n]
        desc = u.description()
        afters = set(u.deps("After"))
        for b_name in units:
            if n in units[b_name].deps("Before"):
                afters.add(b_name)
        need = [d for d in fwd_deps(u, ("Requires", "BindsTo", "Requisite"))]
        bad_dep = [d for d in need if d in failed and d in afters]
        for d in u.deps("Requisite"):
            if not is_activeish(d) and d not in order:
                bad_dep.append(d)
        if u.load_state == "not-found":
            failed.add(n)
            results.append((n, False, "not-found"))
            continue
        if u.load_state == "masked":
            failed.add(n)
            results.append((n, False, "masked"))
            continue
        if u.load_state == "bad-setting":
            failed.add(n)
            results.append((n, False, "bad-setting"))
            if console:
                print("[FAILED] Failed to start %s - %s." % (n, desc))
            continue
        if bad_dep:
            failed.add(n)
            jlog("Dependency failed for %s - %s." % (n, desc), unit=n, prio=3)
            jlog("%s: Job %s/start failed with result 'dependency'." % (n, n), unit=n, prio=4)
            results.append((n, False, "dependency"))
            if console:
                print("[DEPEND] Dependency failed for %s - %s." % (n, desc))
            continue
        for c in u.deps("Conflicts"):
            if is_activeish(c):
                stop_one(c)
        ok, res = start_one(n)
        results.append((n, ok, res))
        if not ok:
            failed.add(n)
        if console:
            if ok and u.type == "target":
                print("[  OK  ] Reached target %s - %s." % (n, desc))
            elif ok and u.type == "service" and u.stype() == "oneshot":
                print("[  OK  ] Finished %s - %s." % (n, desc))
            elif ok:
                print("[  OK  ] Started %s - %s." % (n, desc))
            else:
                print("[FAILED] Failed to start %s - %s." % (n, desc))
    for d in dropped:
        results.append((d, False, "cycle"))
    return results


def stop_set(name):
    """name plus units that must stop with it (Requires=, BindsTo=, PartOf= on it), dependents first."""
    out = [name]
    queue = [name]
    while queue:
        n = queue.pop(0)
        for r in reverse_deps(n, ("Requires", "BindsTo", "PartOf")):
            if r not in out:
                out.append(r)
                queue.append(r)
    return list(reversed(out))


# --------------------------------------------------------------- systemctl

class Opts(object):
    def __init__(self):
        self.all = False
        self.failed = False
        self.now = False
        self.legend = True
        self.plain = False
        self.quiet = False
        self.value = False
        self.props = []
        self.types = []
        self.states = []
        self.reverse = False
        self.runtime = False
        self.lines = 10
        self.signal = "SIGTERM"
        self.kill_whom = "all"
        self.no_block = False
        self.force = False


SYSTEMCTL_UNSUPPORTED_OPTS = ("--user", "--global", "-H", "--host", "-M", "--machine", "--root", "--image",
                              "--job-mode", "--what", "--preset-mode", "--check-inhibitors", "--wait",
                              "--with-dependencies", "--timestamp", "-o", "--output", "--firmware-setup",
                              "--boot-loader-menu", "--boot-loader-entry", "--reboot-argument", "--marked",
                              "--drop-in", "--when", "-T", "--show-transaction", "-i", "--ignore-inhibitors")


def parse_systemctl_args(argv):
    o = Opts()
    args = []
    i = 0
    with_arg = {"-p": "props", "--property": "props", "-P": "P", "-t": "types", "--type": "types",
                "--state": "states", "-s": "signal", "--signal": "signal", "-n": "lines", "--lines": "lines",
                "--kill-whom": "kill_whom", "--kill-who": "kill_whom"}
    while i < len(argv):
        a = argv[i]
        i += 1
        if a == "--":
            args.extend(argv[i:])
            break
        if not a.startswith("-") or a == "-":
            args.append(a)
            continue
        key, val = a, None
        if a.startswith("--") and "=" in a:
            key, val = a.split("=", 1)
        elif not a.startswith("--") and len(a) > 2:
            if a[:2] in with_arg:
                key, val = a[:2], a[2:]
            elif all(c in "alqrf" for c in a[1:]):
                for c in a[1:]:
                    argv.insert(i, "-" + c)
                continue
        if key in with_arg:
            if val is None:
                if i >= len(argv):
                    raise Fail("%s: option '%s' requires an argument" % (PROG, key))
                val = argv[i]
                i += 1
            dest = with_arg[key]
            if dest == "props":
                o.props += [p for p in val.split(",") if p]
            elif dest == "P":
                o.props += [p for p in val.split(",") if p]
                o.value = True
            elif dest == "types":
                for t in val.split(","):
                    if t in UNIT_TYPES:
                        o.types.append(t)
                    elif t in ("help",):
                        print("\n".join(UNIT_TYPES))
                        raise SystemExit(0)
                    else:
                        o.states.append(t)
            elif dest == "states":
                o.states += [s for s in val.split(",") if s]
            elif dest == "signal":
                o.signal = val
            elif dest == "lines":
                try:
                    o.lines = int(val)
                except ValueError:
                    raise Fail("Failed to parse lines '%s'" % val)
            elif dest == "kill_whom":
                o.kill_whom = val
            continue
        if key in ("-a", "--all"):
            o.all = True
        elif key == "--failed":
            o.failed = True
        elif key == "--now":
            o.now = True
        elif key == "--no-legend":
            o.legend = False
        elif key == "--legend":
            o.legend = val not in ("no", "false", "0")
        elif key == "--plain":
            o.plain = True
        elif key in ("-q", "--quiet"):
            o.quiet = True
        elif key == "--value":
            o.value = True
        elif key == "--reverse":
            o.reverse = True
        elif key == "--runtime":
            o.runtime = True
        elif key == "--no-block":
            o.no_block = True
        elif key in ("-f", "--force"):
            o.force = True
        elif key in ("--no-pager", "-l", "--full", "--system", "--no-ask-password", "--no-reload",
                     "--no-warn", "-r", "--recursive", "--show-types", "--after", "--before", "--no-wall"):
            pass
        elif key == "--version":
            print(VERSION_TEXT)
            raise SystemExit(0)
        elif key in ("-h", "--help"):
            print("%s [OPTIONS...] COMMAND ...\n\nMock of systemctl for LinuxMissions; see mocks/README.md." % PROG)
            raise SystemExit(0)
        elif key in SYSTEMCTL_UNSUPPORTED_OPTS:
            unsupported("option %s" % key)
        elif key.startswith("--"):
            raise Fail("%s: unrecognized option '%s'" % (PROG, key))
        else:
            raise Fail("%s: invalid option -- '%s'" % (PROG, key.lstrip("-")[:1]))
    return o, args


def need_units(args, verb):
    if not args:
        raise Fail("Too few arguments.")
    return [resolve_alias(mangle(a)) for a in args]


def glyph(active):
    if active in ("active", "reloading", "refreshing"):
        return "\u25cf"
    if active == "failed":
        return "\u00d7"
    if active in ("activating", "deactivating"):
        return "\u25cf"
    return "\u25cb"


def cmd_start(o, args, verb):
    names = need_units(args, verb)
    rc = 0
    for n in names:
        u = get_unit(n)
        warn_changed(n)
        if u.load_state == "not-found":
            err("Failed to %s %s: Unit %s not found." % (verb, n, n))
            rc = 5
            continue
        if u.load_state == "masked":
            err("Failed to %s %s: Unit %s is masked." % (verb, n, n))
            rc = 1
            continue
        if u.load_state == "bad-setting":
            err("Failed to %s %s: Unit %s has a bad unit file setting.\n"
                "See system logs and 'systemctl status %s' for details." % (verb, n, n, n))
            rc = 1
            continue
        if verb == "start" and u.bool("Unit", "RefuseManualStart"):
            err("Failed to start %s: Operation refused, unit %s may be requested by dependency only "
                "(it is configured to refuse manual start/stop).\nSee system logs and 'systemctl status %s' "
                "for details." % (n, n, n))
            rc = 4
            continue
        results = start_transaction([n])
        for name, ok, res in results:
            if name == n and not ok:
                if res == "cycle":
                    err("Failed to start %s: Transaction order is cyclic. See system logs for details.\n"
                        "See system logs and 'systemctl status %s' for details." % (n, n))
                else:
                    err(job_failed_msg(n, res))
                rc = 1
            elif name == n and ok and get_unit(n).type == "service" and not o.no_block:
                pass
    return rc


def cmd_stop(o, args):
    names = need_units(args, "stop")
    rc = 0
    for n in names:
        u = get_unit(n)
        if u.load_state == "not-found" and not os.path.exists(state_file(n)):
            err("Failed to stop %s: Unit %s not loaded." % (n, n))
            rc = 5
            continue
        warn_changed(n)
        for m in stop_set(n):
            if is_activeish(m):
                stop_one(m)
    return rc


def cmd_restart(o, args, verb):
    names = need_units(args, verb)
    rc = 0
    for n in names:
        u = get_unit(n)
        if verb in ("try-restart", "condrestart", "try-reload-or-restart") and not is_activeish(n):
            continue
        if verb in ("reload-or-restart", "try-reload-or-restart") and u.values("Service", "ExecReload") \
                and is_activeish(n) and u.load_state == "loaded":
            rc = max(rc, do_reload(n, u))
            continue
        if u.load_state == "not-found":
            err("Failed to %s %s: Unit %s not found." % ("restart" if "restart" in verb else verb, n, n))
            rc = 5
            continue
        stopped = []
        for m in stop_set(n):
            if is_activeish(m):
                stop_one(m)
                stopped.append(m)
        rc = max(rc, cmd_start(o, [n], "restart"))
        others = [m for m in stopped if m != n]
        if others:
            start_transaction(others)
    return rc


def do_reload(n, u):
    warn_changed(n)
    if u.type != "service" or not u.values("Service", "ExecReload"):
        err("Failed to reload %s: Job type reload is not applicable for unit %s." % (n, n))
        return 1
    st = live_state(n)
    if st["ActiveState"] not in ("active",):
        err("%s is not active, cannot reload." % n)
        return 1
    desc = u.description()
    update_state(n, ActiveState="reloading", SubState="reload")
    jlog("Reloading %s - %s..." % (n, desc), unit=n)
    ok = run_control_cmds(n, u, "ExecReload", st.get("MainPID", "0"))
    update_state(n, ActiveState="active", SubState=st.get("SubState", "running"))
    if not ok:
        jlog("Reload failed for %s - %s." % (n, desc), unit=n, prio=3)
        err(job_failed_msg(n, "exit-code"))
        return 1
    jlog("Reloaded %s - %s." % (n, desc), unit=n)
    return 0


def run_control_cmds(n, u, key, mainpid="0"):
    """Run ExecReload=/ExecStop=-style commands synchronously from systemctl. -> ok."""
    try:
        env = service_env(u, mainpid=mainpid)
    except ExecFail:
        env = {"MAINPID": str(mainpid), "PATH": FIXED_PATH, "LM_ROOT": ROOT}
    for cmd in u.execs(key):
        try:
            real, args, cwd = exec_prep(u, cmd, env)
        except ExecFail as e:
            for m in e.msgs:
                jlog("%s: %s" % (n, m), unit=n, prio=3)
            if cmd["ignore"]:
                continue
            return False
        p = subprocess.Popen(args, executable=real, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        output = p.communicate()[0]
        for line in output.decode("utf-8", "replace").splitlines():
            jlog(line, ident=os.path.basename(cmd["path"]), pid=p.pid, sunit=n, transport="stdout")
        if p.returncode != 0 and not cmd["ignore"]:
            code, status = ("exited", p.returncode) if p.returncode >= 0 else ("killed", -p.returncode)
            jlog("%s: Control process exited, %s" % (n, fmt_exit(code, status)), unit=n, prio=5)
            return False
    return True


def cmd_reload(o, args):
    rc = 0
    for n in need_units(args, "reload"):
        u = get_unit(n)
        if u.load_state == "not-found":
            err("Failed to reload %s: Unit %s not found." % (n, n))
            rc = 5
            continue
        rc = max(rc, do_reload(n, u))
    return rc


