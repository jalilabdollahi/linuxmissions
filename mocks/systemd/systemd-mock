def boot_timing():
    """Read $ROOT/.lm/boot-timing. -> (phases dict ms, units dict name -> (activating_ms, active_ms, after))."""
    txt = read_text(os.environ.get("LM_BOOT_TIMING") or rp(".lm/boot-timing"))
    if txt is None:
        return None
    phases = {}
    units = {}
    for line in txt.splitlines():
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) == 2 and parts[0] in ("firmware", "loader", "kernel", "initrd", "userspace"):
            phases[parts[0]] = float(parts[1])
            continue
        if len(parts) >= 3:
            after = None
            for extra in parts[3:]:
                if extra.startswith("after="):
                    after = [mangle(x) for x in extra[6:].split(",") if x]
            units[parts[0]] = (float(parts[1]), float(parts[2]), after)
    return phases, units


def analyze_not_finished():
    raise Fail("Bootup is not yet finished (org.freedesktop.systemd1.Manager.FinishTimestampMonotonic=0).\n"
               "Please try again later.\n"
               "Hint: Use 'systemctl list-jobs' to see active jobs", 1)


def analyze_blame(args):
    bt = boot_timing()
    if bt is None:
        analyze_not_finished()
    _phases, units = bt
    rows = [(int(round((end - start) * 1000)), n) for n, (start, end, _a) in units.items() if end > start]
    rows.sort(key=lambda r: (-r[0], r[1]))
    texts = [(format_timespan(us, 1000), n) for us, n in rows]
    w = max([len(t) for t, _ in texts] or [0])
    for t, n in texts:
        print("%s %s" % (t.rjust(w), n))
    return 0


def analyze_time(args):
    bt = boot_timing()
    if bt is None:
        analyze_not_finished()
    phases, units = bt
    parts = []
    total = 0.0
    for k in ("firmware", "loader", "kernel", "initrd", "userspace"):
        if k in phases:
            parts.append("%s (%s)" % (format_timespan(phases[k] * 1000, 1000), k))
            total += phases[k]
    print("Startup finished in %s = %s " % (" + ".join(parts), format_timespan(total * 1000, 1000)))
    target = get_default()
    if target in units:
        print("%s reached after %s in userspace." % (target, format_timespan(units[target][1] * 1000, 1000)))
    return 0


def analyze_critical_chain(args):
    bt = boot_timing()
    if bt is None:
        analyze_not_finished()
    _phases, units = bt
    names = [resolve_alias(mangle(a)) for a in args] or [get_default()]
    print('The time when unit became active or started is printed after the "@" character.\n'
          'The time the unit took to start is printed after the "+" character.\n')

    def times(n):
        t = units.get(n)
        if not t:
            return None
        return int(t[0] * 1000), int(t[1] * 1000)

    def afters(n):
        t = units.get(n)
        deps = []
        if t and t[2] is not None:
            deps = list(t[2])
        st, _f, _r = find_fragment(n)
        if st in ("ok", "builtin"):
            for d in disk_unit(n).deps("After"):
                if d not in deps:
                    deps.append(d)
        return deps

    def label(n, tm):
        if tm is None:
            return n
        start, end = tm
        if end - start > 0:
            return "%s @%s +%s" % (n, format_timespan(start, 1000), format_timespan(end - start, 1000))
        if end > 0:
            return "%s @%s" % (n, format_timespan(end, 1000))
        return n

    def walk(n, level, branches, visited):
        deps = [d for d in afters(n) if times(d) and times(d)[1] > 0]
        if not deps:
            return
        deps.sort(key=lambda d: -times(d)[1])
        longest = times(deps[0])[1]
        sel = [d for d in deps if longest - times(d)[1] <= 0]
        for idx, d in enumerate(sel):
            last = idx == len(sel) - 1
            prefix = ""
            for lv in range(level, 0, -1):
                prefix += "\u2502 " if branches & (1 << (lv - 1)) else "  "
            print(prefix + ("\u2514\u2500" if last else "\u251c\u2500") + label(d, times(d)))
            if d in visited:
                continue
            visited.add(d)
            walk(d, level + 1, (branches << 1) | (0 if last else 1), visited)

    for n in names:
        tm = times(n)
        if tm:
            start, end = tm
            if end - start > 0:
                print("%s +%s" % (n, format_timespan(end - start, 1000)))
            elif end > 0:
                print("%s @%s" % (n, format_timespan(end, 1000)))
            else:
                print(n)
        else:
            print(n)
        walk(n, 0, 0, set([n]))
    return 0


def analyze_verify(args):
    if not args:
        raise Fail("Too few arguments.")
    rc = 0
    for a in args:
        real = None
        if a.startswith("/") and not a.startswith(ROOT + "/"):
            real = root_resolve(a) if os.path.isfile(root_resolve(a)) else None
        elif os.path.isfile(a):
            real = os.path.abspath(a)
        if real is not None:
            name = os.path.basename(a)
            shown = disp(real) if real.startswith(ROOT + "/") else real
            rec = {"name": name, "state": "ok", "fragment": shown, "files": [[shown, read_text(real, "")]]}
            for dpath, dreal in find_dropins(name):
                rec["files"].append([dpath, read_text(dreal, "")])
        else:
            name = resolve_alias(mangle(a))
            rec = disk_record(name)
            if rec["state"] == "not-found":
                err("%s: Failed to load configuration: No such file or directory" % name)
                err("Failed to prepare filename %s: No such file or directory" % a)
                rc = 1
                continue
            if rec["state"] == "masked":
                err("%s: Unit is masked." % name)
                rc = 1
                continue
        u = Unit(rec)
        for w in u.warnings:
            err(w)
        for e in u.errors:
            err(e)
        if u.errors:
            err("%s: Unit configuration has fatal error, unit will not be started." % name)
            rc = 1
            continue
        if u.type == "service":
            for key in ("ExecStartPre", "ExecStart", "ExecStartPost", "ExecReload", "ExecStop", "ExecStopPost"):
                for c in u.execs(key):
                    if c["ignore"]:
                        continue
                    real, _ = resolve_exec(c["path"])
                    if real is None or os.path.isdir(real) or not os.access(real, os.X_OK):
                        why = "No such file or directory" if real is None else "Permission denied"
                        err("%s: Command %s is not executable: %s" % (name, c["path"], why))
                        rc = 1
        for key in ("Requires", "Requisite", "BindsTo"):
            for d in u.deps(key):
                if find_fragment(d)[0] == "not-found":
                    err("%s: Failed to create %s/start: Unit %s not found." % (name, d, d))
                    rc = 1
    return rc


def systemd_analyze_main(argv):
    args = [a for a in argv if not a.startswith("-")]
    for a in argv:
        if a in ("--no-pager", "--system", "-q", "--quiet"):
            continue
        if a == "--version":
            print(VERSION_TEXT)
            return 0
        if a.startswith("-"):
            unsupported("option %s" % a)
    verb = args[0] if args else "time"
    rest = args[1:]
    if verb == "time":
        return analyze_time(rest)
    if verb == "blame":
        return analyze_blame(rest)
    if verb == "critical-chain":
        return analyze_critical_chain(rest)
    if verb == "verify":
        return analyze_verify(rest)
    if verb in ("plot", "dot", "dump", "cat-config", "unit-files", "unit-paths", "exit-status", "capability",
                "condition", "syscall-filter", "filesystems", "calendar", "timestamp", "timespan", "security",
                "inspect-elf", "malloc", "fdstore", "image-policy", "pcrs", "srk", "log-level", "log-target",
                "service-watchdogs", "architectures", "smbios11"):
        unsupported("systemd-analyze %s is" % verb)
    raise Fail("Unknown command verb '%s'." % verb)


# -------------------------------------------------------------- timedatectl

def timedatectl_main(argv):
    args = [a for a in argv if not a.startswith("-")]
    for a in argv:
        if a in ("--no-pager", "--no-ask-password", "-a", "--all", "-p", "--value"):
            continue
        if a.startswith("--property="):
            continue
        if a == "--version":
            print(VERSION_TEXT)
            return 0
        if a.startswith("-"):
            unsupported("option %s" % a)
    verb = args[0] if args else "status"
    t = now()
    name = tz_name()
    tz = get_tz()
    local = localdt(t)
    utc = localdt(t, True)
    if verb == "status":
        rows = [("Local time", local.strftime("%a %Y-%m-%d %H:%M:%S ") + tzabbr(local)),
                ("Universal time", utc.strftime("%a %Y-%m-%d %H:%M:%S UTC")),
                ("RTC time", utc.strftime("%a %Y-%m-%d %H:%M:%S")),
                ("Time zone", "%s (%s, %s)" % (name, tzabbr(local), local.strftime("%z"))),
                ("System clock synchronized", "yes"),
                ("NTP service", "active"),
                ("RTC in local TZ", "no")]
        w = max(len(k) for k, _ in rows)
        for k, v in rows:
            print("%s: %s" % (k.rjust(w), v))
        return 0
    if verb == "show":
        print("Timezone=%s" % name)
        print("LocalRTC=no")
        print("CanNTP=yes")
        print("NTP=yes")
        print("NTPSynchronized=yes")
        print("TimeUSec=%s" % (local.strftime("%a %Y-%m-%d %H:%M:%S ") + tzabbr(local)))
        print("RTCTimeUSec=%s" % (utc.strftime("%a %Y-%m-%d %H:%M:%S UTC")))
        return 0
    if verb == "list-timezones":
        try:
            from zoneinfo import available_timezones
            zones = sorted(available_timezones())
        except Exception:
            zones = ["Etc/UTC"]
        print("\n".join(zones))
        return 0
    if verb == "set-timezone":
        if len(args) != 2:
            raise Fail("Too few arguments." if len(args) < 2 else "Too many arguments.")
        z = args[1]
        if tz_from_name(z) is None or not re.match(r"^[A-Za-z0-9_+/-]+$", z) or z.startswith("+") \
                or (z[0] == "-"):
            raise Fail("Failed to set time zone: Invalid or not installed time zone '%s'" % z)
        write_atomic(rp("etc/timezone"), z + "\n")
        lt = rp("etc/localtime")
        if os.path.lexists(lt):
            os.unlink(lt)
        os.symlink("/usr/share/zoneinfo/" + z, lt)
        return 0
    if verb in ("set-time", "set-local-rtc", "set-ntp", "timesync-status", "show-timesync", "ntp-servers",
                "revert"):
        unsupported("timedatectl %s is" % verb)
    raise Fail("Unknown command verb '%s'." % verb)


# --------------------------------------------------------------------- main

def main():
    global ROOT, PROG, TIMESCALE
    argv = sys.argv[1:]
    if argv[:1] == ["--lm-exec"]:
        ROOT = argv[1]
        exec_trampoline(argv[1:])
        return 203
    if argv[:1] == ["--lm-supervise"]:
        name = argv[1]
        if argv[2:3] == ["--lm-root"]:
            os.environ["LM_ROOT"] = argv[3]
        ROOT = find_root()
        try:
            TIMESCALE = float(os.environ.get("LM_TIMESCALE", "1") or 1)
        except ValueError:
            TIMESCALE = 1.0
        try:
            os.chdir(ROOT)
        except OSError:
            pass
        Supervisor(name).main()
        return 0
    PROG = os.path.basename(sys.argv[0])
    if PROG in ("systemd-mock", "systemd-mock.py") and argv:
        PROG, argv = argv[0], argv[1:]
    ROOT = find_root()
    try:
        TIMESCALE = float(os.environ.get("LM_TIMESCALE", "1") or 1)
    except ValueError:
        TIMESCALE = 1.0
    tools = {"systemctl": systemctl_main, "journalctl": journalctl_main,
             "systemd-analyze": systemd_analyze_main, "timedatectl": timedatectl_main}
    if PROG not in tools:
        err("systemd-mock: run as one of: %s" % ", ".join(sorted(tools)))
        return 1
    try:
        return tools[PROG](argv) or 0
    except Fail as e:
        err(e.msg)
        return e.code
    except BrokenPipeError:
        return 0
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    sys.exit(main())
