        active = st["ActiveState"]
        sub = st["SubState"]
        if u.type != "service" and active == "active" and sub == "running":
            sub = "active"
        load = u.load_state
        if load == "not-found" and not os.path.exists(state_file(n)):
            continue
        if states:
            if not (load in states or active in states or sub in states):
                continue
        elif not o.all and active == "inactive" and load != "not-found":
            continue
        rows.append((n, load, active, sub, u.description() if load != "not-found" else n))
    if not rows and not o.legend:
        return 0
    lines = []
    prefixw = 0 if o.plain else 2
