def quote_env(s):
    if re.search(r"[\s\"'\\]", s):
        return '"%s"' % s.replace("\\", "\\\\").replace('"', '\\"')
    return s


def fmt_exec_prop(c, st, kind):
    procs = []
    try:
        procs = json.loads(st.get("LMProcesses") or "[]")
    except ValueError:
        pass
    pid, code, status, start = 0, "(null)", "0/0", "[n/a]"
    for p in procs:
        if p.get("kind") == kind and p.get("cmd") == c["line"]:
            pid = p["pid"]
            if p.get("code"):
                code = CODE_NAMES.get(str(p["code"]), str(p["code"]))
                status = str(p["status"])
            t = st_time(st, "ExecMainStartTimestamp")
            start = "[%s]" % fmt_ts(t) if t else "[n/a]"
    return "{ path=%s ; argv[]=%s ; ignore_errors=%s ; start_time=%s ; stop_time=[n/a] ; pid=%s ; code=%s ; status=%s }" \
        % (c["path"], " ".join(c["argv"]), "yes" if c["ignore"] else "no", start, pid, code, status)


def unit_props(name):
    u = get_unit(name)
    st = live_state(name)
    P = []

    def add(k, v):
        P.append((k, "" if v is None else str(v)))

    def ts(key):
        t = st_time(st, key)
        return fmt_ts(t) if t is not None else ""
    if u.type == "service":
        add("Type", u.stype())
        add("ExitType", u.svc("ExitType", "main"))
        add("Restart", u.restart())
        add("RestartMode", u.svc("RestartMode", "normal"))
        if u.svc("PIDFile"):
            add("PIDFile", u.svc("PIDFile"))
        add("NotifyAccess", u.svc("NotifyAccess", "none"))
        add("RestartUSec", format_timespan(u.timespan("RestartSec", 0.1) * 1e6))
        add("TimeoutStartUSec", format_timespan(u.timespan("TimeoutStartSec", u.timespan("TimeoutSec", 90)) * 1e6))
        add("TimeoutStopUSec", format_timespan(u.timespan("TimeoutStopSec", u.timespan("TimeoutSec", 90)) * 1e6))
        add("RuntimeMaxUSec", format_timespan(u.timespan("RuntimeMaxSec", float("inf")) * 1e6))
        add("WatchdogUSec", format_timespan(u.timespan("WatchdogSec", 0) * 1e6))
        add("RemainAfterExit", "yes" if u.bool("Service", "RemainAfterExit") else "no")
        add("GuessMainPID", "yes")
        add("MainPID", st.get("MainPID", "0"))
        add("ControlPID", "0")
        add("Result", st.get("Result", "success"))
        add("NRestarts", st.get("NRestarts", "0"))
        add("ExecMainStartTimestamp", ts("ExecMainStartTimestamp"))
        add("ExecMainExitTimestamp", ts("ExecMainExitTimestamp"))
        add("ExecMainPID", st.get("ExecMainPID", "0"))
        add("ExecMainCode", st.get("ExecMainCode", "0"))
        add("ExecMainStatus", st.get("ExecMainStatus", "0"))
        for key in ("ExecCondition", "ExecStartPre", "ExecStart", "ExecStartPost", "ExecReload", "ExecStop",
                    "ExecStopPost"):
            for c in u.execs(key):
                add(key, fmt_exec_prop(c, st, key))
        env = []
        for v in u.values("Service", "Environment"):
            env += ["%s=%s" % kv for kv in parse_env_assignments(v)]
        add("Environment", " ".join(quote_env(e) for e in env))
        for v in u.values("Service", "EnvironmentFile"):
            add("EnvironmentFiles", "%s (ignore_errors=%s)" % (v.lstrip("-"), "yes" if v.startswith("-") else "no"))
        if u.svc("WorkingDirectory"):
            add("WorkingDirectory", u.svc("WorkingDirectory").lstrip("-"))
        if u.svc("User"):
            add("User", u.svc("User"))
        if u.svc("Group"):
            add("Group", u.svc("Group"))
        add("UMask", u.svc("UMask", "0022"))
        lim = u.svc("LimitNOFILE")
        soft, hard = "1024", "524288"
        if lim:
            parts = lim.split(":")
            soft = parts[0].replace("infinity", "infinity")
            hard = parts[1] if len(parts) > 1 else parts[0]
        add("LimitNOFILE", hard)
        add("LimitNOFILESoft", soft)
        for key in ("MemoryMin", "MemoryLow", "MemoryHigh", "MemoryMax", "MemorySwapMax"):
            v = u.svc(key)
            if key == "MemoryMax" and v is None:
                v = u.svc("MemoryLimit")
            default = "0" if key in ("MemoryMin", "MemoryLow") else "infinity"
            if v is None:
                add(key, default)
            else:
                b = parse_bytes(v)
                add(key, v if b is None else b)
        cq = u.svc("CPUQuota")
        if cq and cq.endswith("%"):
            try:
                add("CPUQuotaPerSecUSec", format_timespan(float(cq[:-1]) / 100 * 1e6))
            except ValueError:
                add("CPUQuotaPerSecUSec", "infinity")
        else:
            add("CPUQuotaPerSecUSec", "infinity")
        add("CPUWeight", u.svc("CPUWeight", "[not set]"))
        add("TasksMax", u.svc("TasksMax", "4558"))
        add("KillMode", u.svc("KillMode", "control-group"))
        add("KillSignal", str(sig_num(u.svc("KillSignal", "SIGTERM")) or 15))
        add("NoNewPrivileges", "yes" if u.bool("Service", "NoNewPrivileges") else "no")
        ps = u.svc("ProtectSystem", "no")
        add("ProtectSystem", {"true": "yes", "1": "yes", "false": "no", "0": "no"}.get(ps, ps))
        ph = u.svc("ProtectHome", "no")
        add("ProtectHome", {"true": "yes", "1": "yes", "false": "no", "0": "no"}.get(ph, ph))
        add("PrivateTmp", "yes" if u.bool("Service", "PrivateTmp") else "no")
        add("ReadWritePaths", " ".join(u.values("Service", "ReadWritePaths")))
        add("ReadOnlyPaths", " ".join(u.values("Service", "ReadOnlyPaths")))
        add("StandardOutput", u.svc("StandardOutput", "journal"))
        add("StandardError", u.svc("StandardError", "inherit"))
        if u.svc("SyslogIdentifier"):
            add("SyslogIdentifier", u.svc("SyslogIdentifier"))
    add("Id", name)
    add("Names", name)
    for key in ("Requires", "Requisite", "Wants", "BindsTo", "PartOf", "Upholds", "Conflicts", "Before", "After",
                "OnFailure"):
        vals = u.deps(key)
        if key == "Wants":
            vals += [w for w in wants_dir(name, "wants") if w not in vals]
        if key == "Requires":
            vals += [w for w in wants_dir(name, "requires") if w not in vals]
        if vals:
            add(key, " ".join(vals))
    wb = []
    for base in ("etc/systemd/system", "run/systemd/system", "usr/lib/systemd/system", "lib/systemd/system"):
        for p in glob.glob(rp(base) + "/*.wants/" + name):
            t = os.path.basename(os.path.dirname(p))[:-6]
            if t not in wb:
                wb.append(t)
    if wb:
        add("WantedBy", " ".join(wb))
    rb = []
    for base in ("etc/systemd/system", "run/systemd/system", "usr/lib/systemd/system", "lib/systemd/system"):
        for p in glob.glob(rp(base) + "/*.requires/" + name):
            t = os.path.basename(os.path.dirname(p))[:-9]
            if t not in rb:
                rb.append(t)
    if rb:
        add("RequiredBy", " ".join(rb))
    docs = []
    for d in u.values("Unit", "Documentation"):
        docs += d.split()
    add("Description", u.description())
    if docs:
        add("Documentation", " ".join(quote_env(d) for d in docs))
    add("LoadState", u.load_state)
    add("ActiveState", st.get("ActiveState"))
    add("SubState", st.get("SubState"))
    add("FragmentPath", u.fragment if u.load_state != "masked" else "")
    add("DropInPaths", " ".join(u.dropins))
    add("UnitFileState", enabled_state(name) or "")
    es = enabled_state(name) or ""
    add("UnitFilePreset", "" if es in ("static", "", "indirect") else "enabled")
    add("StateChangeTimestamp", ts("StateChangeTimestamp"))
    add("ActiveEnterTimestamp", ts("ActiveEnterTimestamp"))
    add("ActiveExitTimestamp", ts("ActiveExitTimestamp"))
    add("InactiveEnterTimestamp", ts("InactiveEnterTimestamp"))
    add("InactiveExitTimestamp", ts("InactiveExitTimestamp"))
    add("CanStart", "yes" if not u.bool("Unit", "RefuseManualStart") else "no")
    add("CanStop", "yes")
    add("CanReload", "yes" if u.values("Service", "ExecReload") else "no")
    add("RefuseManualStart", "yes" if u.bool("Unit", "RefuseManualStart") else "no")
    interval, burst = u.start_limit()
    add("StartLimitIntervalUSec", format_timespan(interval * 1e6))
    add("StartLimitBurst", burst)
    add("StartLimitAction", u.get("Unit", "StartLimitAction", "none"))
    known = set(k for k, _ in P)
    for sec, key, _v, _p, _l in u.assign:
        if key not in known:
            vals = u.values(sec, key)
            P.append((key, " ".join(vals) if key in LIST_KEYS else (vals[-1] if vals else "")))
            known.add(key)
    return P


